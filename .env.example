# ArtiCode Academy — local development environment.
# Copy to ./.env (git-ignored) and replace every "change-me" with a random value,
# e.g.  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# This file is the single place where database settings live (ADR-019). It is read by
#   - compose.yaml                       (PostgreSQL container + role bootstrap script)
#   - the backend (ConfigModule reads ../.env after backend/.env) to derive DATABASE_URL
#   - the Prisma CLI (backend/prisma.config.ts) to derive the migration URL
# Variables a reader does not know are ignored; never commit the real file.

# --- PostgreSQL superuser — cluster administration only, never used by the app.
# Applied on the FIRST start of the volume (creates the superuser and the database);
# changing these later does not change an existing volume (see docs, section 11.4).
POSTGRES_USER=articode
POSTGRES_PASSWORD=change-me
POSTGRES_DB=articode_academy
# Host port, published on 127.0.0.1 only. The backend connects to the same port.
POSTGRES_PORT=5432

# --- Migrations role — owns the database and its schema; used by `prisma migrate`.
# Created (or its password re-applied) by docker/postgres/initdb/10-roles.sh:
# automatically on the first start, or by hand on an existing volume with
#   docker compose exec -T postgres bash /docker-entrypoint-initdb.d/10-roles.sh
DB_MIGRATOR_USER=articode_migrator
DB_MIGRATOR_PASSWORD=change-me

# --- Application role — SELECT / INSERT / UPDATE / DELETE only; used by the NestJS runtime.
DB_APP_USER=articode_app
DB_APP_PASSWORD=change-me

# Host the backend connects to (127.0.0.1, not localhost, to stay on IPv4 loopback).
# When the backend itself runs inside Docker Compose, set DATABASE_URL and
# MIGRATION_DATABASE_URL explicitly instead (host "postgres", port 5432).
# DB_HOST=127.0.0.1
