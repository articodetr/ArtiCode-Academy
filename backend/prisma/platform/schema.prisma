// Prisma schema of the PLATFORM database `articode_platform` (MOD-18, ADR-021,
// master doc 6.6.2/6.6.3) — the control plane of the Super Admin.
//
// A second, independent schema next to the academy one (../schema.prisma): its
// own config (../../prisma.platform.config.ts, run every CLI command with
// `--config prisma.platform.config.ts`), its own migrations (./migrations), its
// own generated client (src/generated/platform) and its own roles
// (`platform_migrator` owns the database, `platform_app` has DML only —
// docker/postgres/initdb/20-platform.sh, the ADR-019 pattern).
//
// No foreign key reaches an academy database: the only link is `academies.id`
// here = `academy.platform_academy_id` in the academy's own database. v1 stores
// NO database credentials of any academy.
//
// Same conventions as the academy schema: PascalCase models mapped to
// snake_case tables/columns, UUIDv7 primary keys generated by PostgreSQL 18,
// localized text as jsonb `{ ar, en?, tr? }` with `ar` required. What Prisma
// cannot express — the CHECKs, the two partial unique indexes and the
// append-only triggers of platform_audit_logs — is hand-written at the end of
// the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/platform"

  // Match the backend's ESM + NodeNext setup (imports end in .js).
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// What a platform user may do; ROLE-01 (Super Admin) lives here, never in an academy database.
enum PlatformRole {
  super_admin
  support

  @@map("platform_role")
}

enum PlatformUserStatus {
  active
  suspended

  @@map("platform_user_status")
}

/// Lifecycle of an academy in the registry.
enum AcademyStatus {
  provisioning
  active
  suspended
  archived

  @@map("academy_status")
}

enum DomainKind {
  platform_subdomain
  custom

  @@map("domain_kind")
}

enum SubscriptionStatus {
  trial
  active
  past_due
  canceled
  expired

  @@map("subscription_status")
}

/// Verdict of one probe of an academy's readiness endpoint.
enum ProbeOutcome {
  ready
  not_ready
  unreachable
  invalid

  @@map("probe_outcome")
}

// ---------------------------------------------------------------------------
// Platform identity
// ---------------------------------------------------------------------------

/// A Super Admin or support account of the platform (separate from every academy's users).
model PlatformUser {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stored trimmed and lower-case (CHECK).
  email             String             @unique
  fullName          String             @map("full_name")
  /// argon2id hash; null until the account has a password.
  passwordHash      String?            @map("password_hash")
  role              PlatformRole
  status            PlatformUserStatus @default(active)
  failedLoginCount  Int                @default(0) @map("failed_login_count")
  lockedUntil       DateTime?          @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?          @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens         PlatformRefreshToken[]
  auditLogs             PlatformAuditLog[]
  academiesCreated      Academy[]              @relation("AcademyCreatedBy")
  healthChecksTriggered AcademyHealthCheck[]   @relation("AcademyHealthCheckTriggeredBy")

  @@map("platform_users")
}

/// Refresh tokens of platform sessions — the shape of the academy `refresh_tokens`.
model PlatformRefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the token (hex); the token itself is never stored.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @default(dbgenerated("uuidv7()")) @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       PlatformUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy PlatformRefreshToken? @relation("PlatformRefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   PlatformRefreshToken? @relation("PlatformRefreshTokenRotation")

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("platform_refresh_tokens")
}

/// Append-only log of platform events (triggers in the migration SQL): an UPDATE
/// may only clear `actor_platform_user_id` (the SetNull action); DELETE and
/// TRUNCATE are refused.
model PlatformAuditLog {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorPlatformUserId String?  @map("actor_platform_user_id") @db.Uuid
  /// Dotted event name such as `platform.academies.created`.
  action              String
  entityType          String?  @map("entity_type")
  entityId            String?  @map("entity_id") @db.Uuid
  metadata            Json?
  ipAddress           String?  @map("ip_address") @db.Inet
  userAgent           String?  @map("user_agent")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor PlatformUser? @relation(fields: [actorPlatformUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorPlatformUserId])
  @@index([entityType, entityId])
  @@map("platform_audit_logs")
}

// ---------------------------------------------------------------------------
// Academies registry
// ---------------------------------------------------------------------------

/// One deployed academy. `id` is the academy database's `academy.platform_academy_id`.
model Academy {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The slug rule of deploy/scripts/new-academy-env.mjs (compose project `academy-<slug>`).
  slug         String        @unique
  /// Localized `{ ar, en?, tr? }`, `ar` a non-empty string (CHECK).
  name         Json
  status       AcademyStatus @default(provisioning)
  /// Public origin of the academy (https, or http on localhost / 127.0.0.1 only).
  origin       String?
  contactEmail String?       @map("contact_email")
  notes        String?
  createdById  String?       @map("created_by") @db.Uuid
  /// Set exactly when status = archived (CHECK).
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     PlatformUser?        @relation("AcademyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  domains       Domain[]
  subscriptions Subscription[]
  healthChecks  AcademyHealthCheck[]

  @@index([createdById])
  @@map("academies")
}

/// A hostname an academy is served at; at most one primary per academy (partial unique, SQL).
model Domain {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  academyId  String     @map("academy_id") @db.Uuid
  /// Lower-case (CHECK).
  hostname   String     @unique
  kind       DomainKind
  isPrimary  Boolean    @default(false) @map("is_primary")
  verifiedAt DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([academyId])
  @@map("domains")
}

// ---------------------------------------------------------------------------
// Plans and subscriptions
// ---------------------------------------------------------------------------

model Plan {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key       String   @unique
  /// Localized `{ ar, en?, tr? }`, `ar` a non-empty string (CHECK).
  name      Json
  /// Limits such as students or storage; a JSON object (CHECK).
  limits    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

/// At most one current (trial | active | past_due) subscription per academy (partial unique, SQL).
model Subscription {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  academyId   String             @map("academy_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus
  startsAt    DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?          @map("ends_at") @db.Timestamptz(6)
  trialEndsAt DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  /// Also the index of the academy_id foreign key (leading column).
  @@index([academyId, status])
  @@index([planId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Fleet health
// ---------------------------------------------------------------------------

/// One probe of an academy's readiness endpoint (periodic, or triggered by a platform user).
model AcademyHealthCheck {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  academyId      String       @map("academy_id") @db.Uuid
  checkedAt      DateTime     @default(now()) @map("checked_at") @db.Timestamptz(6)
  outcome        ProbeOutcome
  httpStatus     Int?         @map("http_status")
  latencyMs      Int?         @map("latency_ms")
  apiVersion     String?      @map("api_version")
  environment    String?
  schemaStatus   String?      @map("schema_status")
  schemaExpected String?      @map("schema_expected")
  schemaApplied  String?      @map("schema_applied")
  reason         String?
  /// At most 500 characters (CHECK).
  error          String?
  /// Null for the periodic probe.
  triggeredById  String?      @map("triggered_by") @db.Uuid

  academy     Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  triggeredBy PlatformUser? @relation("AcademyHealthCheckTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  /// Also the index of the academy_id foreign key (leading column).
  @@index([academyId, checkedAt(sort: Desc)])
  @@index([triggeredById])
  @@map("academy_health_checks")
}
