// Prisma schema for the ArtiCode Academy backend (ADR-014, ADR-020).
//
// One database per academy, so no table carries an academy_id (D2). Models are
// PascalCase and map to snake_case tables/columns (P2); every primary key is a
// UUIDv7 generated inside PostgreSQL 18 (D4). What Prisma cannot express —
// CHECK constraints, the partial unique index of guardian_students and the
// append-only trigger of audit_logs — is written by hand at the end of the
// migration SQL (docs/PROJECT_DOCUMENTATION.md, section 06).
//
// Connection URL: prisma.config.ts for the CLI, ConfigService at runtime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Match the backend's ESM + NodeNext setup (imports end in .js).
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (small, stable sets — P6). Mapped to snake_case PostgreSQL types.
// ---------------------------------------------------------------------------

/// Languages localized text can be stored in; `ar` is the reference language (D1).
enum Locale {
  ar
  en
  tr

  @@map("locale")
}

enum UserStatus {
  invited
  pending
  active
  suspended
  archived

  @@map("user_status")
}

/// Employment category of an employee profile; roles stay independent (D20).
enum EmployeeKind {
  teacher
  staff

  @@map("employee_kind")
}

enum GuardianRelationship {
  father
  mother
  sibling
  legal_guardian
  other

  @@map("guardian_relationship")
}

/// `mfa_challenge` (MOD-01-H06, D-R108): the short-lived login challenge
/// between the password and the second factor — stored as a hash only.
enum TokenPurpose {
  invitation
  email_verification
  password_reset
  mfa_challenge

  @@map("token_purpose")
}

/// Publication state of a course (MOD-04, D-R13/D-R14): holders of
/// `courses.read` alone see `published` only; `archived` replaces deletion.
enum CourseStatus {
  draft
  published
  archived

  @@map("course_status")
}

// ---------------------------------------------------------------------------
// MOD-02 / MOD-14 — academy identity (exactly one row per database)
// ---------------------------------------------------------------------------

/// Identity and settings of this deployment. The `singleton` column is always
/// true and unique, so the table can hold a single row (CHECK in SQL).
model Academy {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singleton         Boolean  @unique @default(true)
  /// Id of this academy in the central platform database (no FK — separate databases).
  platformAcademyId String?  @unique @map("platform_academy_id") @db.Uuid
  slug              String   @unique @db.VarChar(64)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name              Json
  logoUrl           String?  @map("logo_url")
  defaultLocale     Locale   @default(ar) @map("default_locale")
  /// IANA time zone name, chosen per academy.
  timezone          String
  /// ISO 4217 code, chosen per academy (CHECK in SQL).
  currency          String   @db.Char(3)
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone") @db.VarChar(32)
  /// Free-form settings validated by zod in the service layer (D3).
  settings          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("academy")
}

// ---------------------------------------------------------------------------
// MOD-03 / MOD-01 — people, roles, permissions
// ---------------------------------------------------------------------------

/// One row per person whatever their roles. The kind of user follows from
/// user_roles and the profiles. Every account has a unique login identifier:
/// email or username, both stored lower-case (CHECKs in SQL — D13).
model User {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email              String?    @unique
  username           String?    @unique @db.VarChar(64)
  /// E.164; deliberately not unique — siblings may share a guardian's phone (D21).
  phone              String?    @db.VarChar(32)
  /// argon2id hash; null for invited accounts that have not set a password yet (P9).
  passwordHash       String?    @map("password_hash")
  fullName           String     @map("full_name")
  /// Latin-script name for English certificates and reports (D12).
  fullNameLatin      String?    @map("full_name_latin")
  displayName        String?    @map("display_name")
  avatarUrl          String?    @map("avatar_url")
  /// Preferred language; null means the academy's default_locale.
  locale             Locale?
  status             UserStatus @default(invited)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount   Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete (D7): the row stays because history refers to it.
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)
  /// MOD-01-H06 (D-R107/D-R108): the TOTP secret sealed by the app with
  /// AES-256-GCM (`v1.<iv>.<ciphertext>.<tag>`); NULL = MFA off. Set together
  /// with `mfaEnabledAt` (CHECKs in SQL).
  mfaSecret          String?    @map("mfa_secret")
  mfaEnabledAt       DateTime?  @map("mfa_enabled_at") @db.Timestamptz(6)
  /// The last accepted TOTP step (replay guard: a code is never accepted twice in its window); only with `mfaSecret`.
  mfaLastStep        BigInt?    @map("mfa_last_step")
  /// A setup not confirmed yet (sealed like `mfaSecret`; valid for 10 minutes from `mfaPendingAt`).
  mfaPendingSecret   String?    @map("mfa_pending_secret")
  mfaPendingAt       DateTime?  @map("mfa_pending_at") @db.Timestamptz(6)

  roles                   UserRole[]
  assignedRoles           UserRole[]               @relation("UserRoleAssignedBy")
  studentProfile          StudentProfile?
  employeeProfile         EmployeeProfile?
  /// Links where this user is the guardian.
  guardianOf              GuardianStudent[]        @relation("GuardianStudentGuardian")
  /// Links where this user is the student.
  guardians               GuardianStudent[]        @relation("GuardianStudentStudent")
  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]
  auditLogs               AuditLog[]
  /// Courses this user created (MOD-04); the link is cleared if the user row goes.
  coursesCreated          Course[]                 @relation("CourseCreatedBy")
  /// MOD-05: classes this user created, classes they teach (and teacher
  /// assignments they made), their enrollments as a student and the
  /// enrollments they created.
  classesCreated          Class[]                  @relation("ClassCreatedBy")
  classTeacherships       ClassTeacher[]           @relation("ClassTeacherTeacher")
  classTeacherAssignments ClassTeacher[]           @relation("ClassTeacherAssignedBy")
  enrollments             Enrollment[]             @relation("EnrollmentStudent")
  enrollmentsCreated      Enrollment[]             @relation("EnrollmentCreatedBy")
  /// MOD-19: enrollment requests this user rejected (D-R126).
  enrollmentsRejected     Enrollment[]             @relation("EnrollmentRejectedBy")
  /// MOD-07: weekly slots this user teaches and the slots they created.
  classSchedulesTaught    ClassSchedule[]          @relation("ClassScheduleTeacher")
  classSchedulesCreated   ClassSchedule[]          @relation("ClassScheduleCreatedBy")
  /// MOD-06: lessons this user teaches or created, their attendance as a
  /// student and the attendance records they wrote as a teacher.
  lessonsTaught           Lesson[]                 @relation("LessonTeacher")
  lessonsCreated          Lesson[]                 @relation("LessonCreatedBy")
  attendanceRecords       AttendanceRecord[]       @relation("AttendanceStudent")
  attendanceRecorded      AttendanceRecord[]       @relation("AttendanceRecordedBy")
  /// MOD-08: assignments this user created, their submissions as a student
  /// and the submissions they graded or returned as a teacher.
  assignmentsCreated      Assignment[]             @relation("AssignmentCreatedBy")
  submissions             AssignmentSubmission[]   @relation("SubmissionStudent")
  submissionsGraded       AssignmentSubmission[]   @relation("SubmissionGradedBy")
  /// MOD-09: exams this user created, their recorded results as a student,
  /// the results they recorded as a teacher and the final grades they fixed.
  examsCreated            Exam[]                   @relation("ExamCreatedBy")
  examResults             ExamResult[]             @relation("ExamResultStudent")
  examResultsRecorded     ExamResult[]             @relation("ExamResultRecordedBy")
  finalGradesFinalized    FinalGrade[]             @relation("FinalGradeFinalizedBy")
  /// MOD-10: certificates of this user as a student, and those they issued or revoked.
  certificates            Certificate[]            @relation("CertificateStudent")
  certificatesIssued      Certificate[]            @relation("CertificateIssuedBy")
  certificatesRevoked     Certificate[]            @relation("CertificateRevokedBy")
  /// MOD-11: fee plans they created, invoices as a student, invoices they issued, cancelled or created, payments they recorded or reversed.
  feePlansCreated         FeePlan[]                @relation("FeePlanCreatedBy")
  invoices                Invoice[]                @relation("InvoiceStudent")
  invoicesIssued          Invoice[]                @relation("InvoiceIssuedBy")
  invoicesCancelled       Invoice[]                @relation("InvoiceCancelledBy")
  invoicesCreated         Invoice[]                @relation("InvoiceCreatedBy")
  paymentsRecorded        Payment[]                @relation("PaymentRecordedBy")
  paymentsReversed        Payment[]                @relation("PaymentReversedBy")
  /// MOD-12: notifications they received (deleted with them), notifications about them as a student, their e-mail preferences and the announcements they sent.
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationsAbout      Notification[]           @relation("NotificationStudent")
  notificationPreferences NotificationPreference[]
  announcementsSent       Announcement[]           @relation("AnnouncementSender")
  /// MOD-01-H06: their one-time MFA recovery codes (hashes only; deleted with them).
  mfaRecoveryCodes        MfaRecoveryCode[]
  /// MOD-20: their own learning progress as a student (Restrict — accounts are soft-deleted, never removed).
  learningProgress        LearningProgress[]       @relation("LearningProgressStudent")
  /// MOD-09 phase 2: question banks and questions they authored, and their own online exam attempts as a student.
  questionBanksCreated    QuestionBank[]           @relation("QuestionBankCreatedBy")
  questionsCreated        Question[]               @relation("QuestionCreatedBy")
  examAttempts            ExamAttempt[]            @relation("ExamAttemptStudent")

  @@index([phone])
  @@index([status])
  @@map("users")
}

/// System roles (seeded, `isSystem`) and custom roles created by the academy (ROLE-07).
model Role {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                String   @unique @db.VarChar(64)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  label              Json
  description        Json?
  isSystem           Boolean  @default(false) @map("is_system")
  /// Granted automatically on self-registration (usually `student`).
  isDefaultForSignup Boolean  @default(false) @map("is_default_for_signup")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permission catalog seeded from the code (D8). Keys look like `users.read`;
/// obsolete keys are marked `deprecatedAt`, never deleted while referenced.
model Permission {
  key          String    @id @db.VarChar(100)
  module       String    @db.VarChar(32)
  description  Json?
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// A user may hold several roles (teacher + staff). Deleting a role that is
/// still granted fails (Restrict); deleting the user removes the grants.
model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

/// 1:1 with users; created in the same transaction as the `student` role.
model StudentProfile {
  userId        String    @id @map("user_id") @db.Uuid
  studentNumber String?   @unique @map("student_number") @db.VarChar(32)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  enrolledOn    DateTime? @map("enrolled_on") @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

/// 1:1 with users for teachers and staff alike (D20). `kind` is the employment
/// category only; what the person may do comes from user_roles. Specialised
/// data can be added later as columns or 1:1 tables.
model EmployeeProfile {
  userId         String       @id @map("user_id") @db.Uuid
  employeeNumber String?      @unique @map("employee_number") @db.VarChar(32)
  kind           EmployeeKind
  jobTitle       String?      @map("job_title")
  specialization String?
  /// Localized text (D1), optional.
  bio            Json?
  hiredOn        DateTime?    @map("hired_on") @db.Date
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind])
  @@map("employee_profiles")
}

/// Guardians ↔ students (n:m). A student has at most one primary guardian
/// (partial unique index in SQL) and cannot be their own guardian (CHECK in SQL).
model GuardianStudent {
  guardianUserId String               @map("guardian_user_id") @db.Uuid
  studentUserId  String               @map("student_user_id") @db.Uuid
  relationship   GuardianRelationship
  isPrimary      Boolean              @default(false) @map("is_primary")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian User @relation("GuardianStudentGuardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianStudentStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@id([guardianUserId, studentUserId])
  @@index([studentUserId])
  @@map("guardian_students")
}

// ---------------------------------------------------------------------------
// MOD-01 — session and one-time tokens (hashes only — P9)
// ---------------------------------------------------------------------------

/// Rotating refresh tokens. All tokens of one login share `familyId`; reuse of
/// a rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the token (hex); the token itself is never stored.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @default(dbgenerated("uuidv7()")) @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One-time tokens: invitations, e-mail verification, password reset.
model VerificationToken {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  /// Purpose-specific data, e.g. the roles an invitation grants.
  metadata   Json?
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Cross-cutting — audit log (append-only through a trigger — D5)
// ---------------------------------------------------------------------------

/// Written by the service layer inside the transaction of the event. Never
/// updated or deleted (trigger in SQL). `metadata` holds no secrets (P11).
model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Dotted event name such as `auth.login.succeeded` or `roles.permissions.changed`.
  action      String   @db.VarChar(64)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  /// Text so that non-UUID keys (e.g. permissions.key) fit.
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// MOD-04 — courses, levels and syllabus (roadmap §4c; owner decisions
// D-R11..D-R14). Subset of master doc 6.7.4-C: no categories, prerequisites,
// price/currency, cover file or soft delete — archiving replaces deletion.
// ---------------------------------------------------------------------------

/// Reference list of course levels managed by the academy (not an enum — 6.7.1).
/// `sort_order` is unique but DEFERRABLE (SQL) so a reorder can swap values
/// inside one transaction.
model Level {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique @db.VarChar(16)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name        Json
  description Json?
  sortOrder   Int      @map("sort_order") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses Course[]

  @@unique([sortOrder], map: "uq_levels_sort_order")
  @@map("levels")
}

/// A course as an educational product. Deleting is allowed only for an unused
/// draft (service rule); otherwise it is archived (D-R14).
model Course {
  id                  String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                String       @unique @db.VarChar(32)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name                Json
  summary             Json?
  description         Json?
  levelId             String?      @map("level_id") @db.Uuid
  status              CourseStatus @default(draft)
  durationHours       Decimal?     @map("duration_hours") @db.Decimal(6, 1)
  sessionsCount       Int?         @map("sessions_count") @db.SmallInt
  /// MOD-19 (D-R129): an absolute http(s) URL of the cover image, no upload (CHECK in SQL).
  coverImageUrl       String?      @map("cover_image_url")
  /// MOD-19 (D-R122): the fee plan that prices a self-service enrollment; null = a free course.
  /// NO ACTION: a plan a course points to cannot be deleted (409 fee_plan_in_use).
  enrollmentFeePlanId String?      @map("enrollment_fee_plan_id") @db.Uuid
  minAge              Int?         @map("min_age") @db.SmallInt
  maxAge              Int?         @map("max_age") @db.SmallInt
  createdById         String?      @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  level             Level?               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  createdBy         User?                @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  syllabusItems     CourseSyllabusItem[]
  /// MOD-05: runs of this course (Restrict — a course with classes cannot be deleted).
  classes           Class[]
  /// MOD-10: certificates of this course (Restrict).
  certificates      Certificate[]
  /// MOD-11: fee plans pricing this course (deleted with it).
  feePlans          FeePlan[]            @relation("FeePlanCourse")
  /// MOD-19: the plan charged for an enrollment request (D-R122).
  enrollmentFeePlan FeePlan?             @relation("CourseEnrollmentFeePlan", fields: [enrollmentFeePlanId], references: [id], onDelete: NoAction)
  /// MOD-20: the curriculum levels of this course (deleted with it).
  sections          CourseSection[]
  /// MOD-20: the learners' progress on this course's lessons (Restrict).
  learningProgress  LearningProgress[]
  /// MOD-09 phase 2: question banks filed under this course (SetNull — a bank outlives its course).
  questionBanks     QuestionBank[]

  @@index([status])
  @@index([levelId])
  @@index([createdById])
  @@index([enrollmentFeePlanId])
  @@map("courses")
}

/// One ordered item of a course syllabus — the lesson template MOD-06 builds on.
/// `(course_id, sort_order)` is unique but DEFERRABLE (SQL) for reordering.
model CourseSyllabusItem {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId         String           @map("course_id") @db.Uuid
  sortOrder        Int              @map("sort_order") @db.SmallInt
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  title            Json
  description      Json?
  estimatedMinutes Int?             @map("estimated_minutes") @db.SmallInt
  /// MOD-20 (D-R130): the curriculum level («المستوى») of the course the lesson sits in; null = not placed in one.
  sectionId        String?          @map("section_id") @db.Uuid
  /// MOD-20 (D-R131): what the lesson holds; its `content` follows this kind (validated in code).
  kind             LearningItemKind @default(text)
  /// MOD-20 (D-R131): the lesson's content by kind — an object (CHECK in SQL); null = no content yet.
  content          Json?
  /// MOD-20: downloadable resources `[{ title, url }]` — an array of at most 20 (CHECK in SQL).
  resources        Json             @default("[]")
  /// MOD-20 (D-R135): a required lesson counts in the course progress; an optional one never blocks it.
  isRequired       Boolean          @default(true) @map("is_required")
  /// MOD-20 (D-R135): an unpublished lesson is hidden from learners and left out of their progress.
  isPublished      Boolean          @default(true) @map("is_published")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// MOD-20: the level the lesson sits in (the link is cleared when the level goes).
  section  CourseSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// MOD-06: lessons that cover this item (the link is cleared when the item goes).
  lessons  Lesson[]
  /// MOD-20: the learners' progress on this lesson (Restrict — a lesson someone studied is unpublished, never deleted).
  progress LearningProgress[]

  @@unique([courseId, sortOrder], map: "uq_course_syllabus_items_course_order")
  /// MOD-20: the target of the composite FK that keeps `learning_progress.course_id` equal to the lesson's course.
  @@unique([id, courseId], map: "uq_course_syllabus_items_id_course")
  @@index([sectionId])
  @@map("course_syllabus_items")
}

// ---------------------------------------------------------------------------
// MOD-05 — classes, class teachers and enrollments (roadmap §4d; owner
// decisions D-R15..D-R18). Subset of master doc 6.7.4-C: no academic terms,
// branches, rooms, price override, enrollment window, final grade or soft
// delete — cancelling replaces deletion (D-R17).
// ---------------------------------------------------------------------------

enum ClassStatus {
  planned
  open
  running
  completed
  cancelled

  @@map("class_status")
}

enum ClassTeacherRole {
  lead
  assistant

  @@map("class_teacher_role")
}

/// `pending` is not used by version 1 (no waitlist — D-R18); it exists so a
/// later waitlist needs no enum migration.
enum EnrollmentStatus {
  pending
  active
  completed
  withdrawn
  cancelled

  @@map("enrollment_status")
}

/// Version 1 writes `admin` only (D-R18); the other sources are reserved for
/// self-enrollment, imports and transfers.
enum EnrollmentSource {
  admin
  self
  import
  transfer

  @@map("enrollment_source")
}

/// A run of a published course for a group of students (D-R15). The status
/// moves through manual actions only (D-R17); only a `planned` class without
/// enrollments can be deleted, any other is cancelled. The enrolled count is
/// computed from `enrollments`, never stored (6.7.4-C).
model Class {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId       String      @map("course_id") @db.Uuid
  code           String      @unique @db.VarChar(32)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name           Json
  /// Hard capacity (D-R18); > 0 (CHECK in SQL).
  capacity       Int         @db.SmallInt
  status         ClassStatus @default(planned)
  /// Display dates only (D-R17); ends_on >= starts_on (CHECK in SQL).
  startsOn       DateTime?   @map("starts_on") @db.Date
  endsOn         DateTime?   @map("ends_on") @db.Date
  notes          String?
  /// MOD-19 (D-R123): open to self-service enrollment from the catalog while open/running and the course is published.
  selfEnrollment Boolean     @default(false) @map("self_enrollment")
  createdById    String?     @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course        Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy     User?           @relation("ClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  teachers      ClassTeacher[]
  enrollments   Enrollment[]
  /// MOD-07: the weekly slots of this class (deleted with it).
  schedules     ClassSchedule[]
  lessons       Lesson[]
  assignments   Assignment[]
  /// MOD-09: the exams of this class (deleted with it).
  exams         Exam[]
  /// MOD-10: the certificates of this class (Restrict — never deleted).
  certificates  Certificate[]
  /// MOD-11: fee plans pricing this class (deleted with it).
  feePlans      FeePlan[]
  /// MOD-12: announcements sent to this class (they stay, without the link, if it goes).
  announcements Announcement[]

  @@index([courseId])
  @@index([status])
  @@index([createdById])
  @@map("classes")
}

/// Teachers of a class: at most one `lead` per class (partial unique index
/// `uq_class_teachers_lead` in SQL) and any number of assistants.
model ClassTeacher {
  classId       String           @map("class_id") @db.Uuid
  teacherUserId String           @map("teacher_user_id") @db.Uuid
  role          ClassTeacherRole
  assignedAt    DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById  String?          @map("assigned_by") @db.Uuid

  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User  @relation("ClassTeacherTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("ClassTeacherAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([classId, teacherUserId])
  @@index([teacherUserId])
  @@index([assignedById])
  @@map("class_teachers")
}

/// A student's enrollment in a class — one row per (class, student):
/// enrolling again reactivates the same row. `status` has no default, so
/// every writer states it (version 1 writes `active` directly — D-R18).
model Enrollment {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId          String           @map("class_id") @db.Uuid
  studentUserId    String           @map("student_user_id") @db.Uuid
  status           EnrollmentStatus
  source           EnrollmentSource @default(admin)
  enrolledAt       DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  activatedAt      DateTime?        @map("activated_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)
  withdrawnAt      DateTime?        @map("withdrawn_at") @db.Timestamptz(6)
  withdrawalReason String?          @map("withdrawal_reason")
  /// MOD-19 (D-R121): when the current request was made; required while `pending` (CHECK in SQL).
  requestedAt      DateTime?        @map("requested_at") @db.Timestamptz(6)
  /// MOD-19 (D-R126): a rejected request is `cancelled` with these set; the reason is required (CHECKs in SQL).
  rejectedAt       DateTime?        @map("rejected_at") @db.Timestamptz(6)
  rejectedById     String?          @map("rejected_by") @db.Uuid
  rejectionReason  String?          @map("rejection_reason")
  createdById      String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class        Class         @relation(fields: [classId], references: [id], onDelete: Restrict)
  student      User          @relation("EnrollmentStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rejectedBy   User?         @relation("EnrollmentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  /// MOD-09: the final grade fixed for this enrollment (D-R44/D-R45), if any.
  finalGrade   FinalGrade?
  /// MOD-10: its certificates — at most one `issued` (partial unique in SQL).
  certificates Certificate[]
  /// MOD-11: invoices billed for this enrollment (the link is cleared if it goes).
  invoices     Invoice[]

  @@unique([classId, studentUserId], map: "uq_enrollments_class_student")
  @@index([studentUserId])
  @@index([status])
  @@index([createdById])
  @@index([rejectedById])
  @@index([requestedAt])
  @@map("enrollments")
}

// MOD-02 (O8) — branches (D-R19, CH-0087)

/// A site of the academy (D14/D-R19). Rooms point to it since MOD-07-T01
/// (O9); branch-scoped roles come later and classes get no `branch_id` — a
/// class is placed through the rooms of its slots (D-R22, D-R24). At most one main branch (partial unique index in SQL) and a main
/// branch is active (CHECK). No `deleted_at`: like `levels`, a branch is
/// deactivated, or deleted while nothing uses it.
model Branch {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Trimmed and upper-cased by the API; CHECK in SQL.
  code      String   @unique @db.VarChar(16)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name      Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  address   Json?
  /// E.164, validated by the API.
  phone     String?  @db.VarChar(32)
  /// IANA time zone when it differs from the academy's; NULL = the academy's.
  timezone  String?
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms Room[]

  @@map("branches")
}

// ---------------------------------------------------------------------------
// MOD-07 (O9) — rooms and weekly class schedules (roadmap §4e; owner
// decisions D-R23..D-R29, CH-0090). Subset of master doc 6.7.4: no academic
// terms or holidays (D-R23), no default room or branch on `classes` (D-R24).
// Room and teacher double-booking is refused by two EXCLUDE constraints in
// SQL (extension `btree_gist` — D-R25), which Prisma cannot express.
// ---------------------------------------------------------------------------

enum RoomKind {
  classroom
  lab
  hall
  virtual

  @@map("room_kind")
}

/// A place where a class meets. Without a branch it belongs to the academy's
/// own site. The code is unique inside its branch, and rooms without a branch
/// share one namespace (the unique index is NULLS NOT DISTINCT in SQL). No
/// `deleted_at`: a room is deactivated, or deleted while nothing uses it.
model Room {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  /// Trimmed by the API; CHECK in SQL.
  code      String   @db.VarChar(16)
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  name      Json?
  /// > 0 when set (CHECK in SQL); not checked against class capacity (§4e.1).
  capacity  Int?     @db.SmallInt
  kind      RoomKind @default(classroom)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  schedules ClassSchedule[]
  /// MOD-06: lessons held in this room (a room with lessons cannot be deleted).
  lessons   Lesson[]

  /// Also covers the `branch_id` foreign key (its first column).
  @@unique([branchId, code], map: "uq_rooms_branch_code")
  @@map("rooms")
}

/// One recurring weekly slot of a class: a weekday, a local start/end time
/// (the time zone of the room's branch, else the academy's), an optional room
/// and teacher, and an effective date range (`effective_to` NULL = open-ended).
/// Lessons are generated from it later (T05); the times become timestamptz
/// only then.
model ClassSchedule {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday, like `scheduling.*` (CHECK in SQL).
  weekday       Int       @db.SmallInt
  /// Local wall-clock times; end > start (CHECK in SQL). Adjacent slots do not
  /// overlap (half-open ranges in the EXCLUDE constraints).
  startTime     DateTime  @map("start_time") @db.Time(0)
  endTime       DateTime  @map("end_time") @db.Time(0)
  roomId        String?   @map("room_id") @db.Uuid
  /// One of the class's teachers (service rule — D-R26); NULL = the lead teacher.
  teacherUserId String?   @map("teacher_user_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// Inclusive; NULL = no end; >= effective_from (CHECK in SQL).
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  teacher   User?    @relation("ClassScheduleTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("ClassScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// MOD-06: lessons generated from this slot (the link is cleared when the slot goes).
  lessons   Lesson[]

  @@index([classId])
  @@index([roomId, weekday])
  @@index([teacherUserId, weekday])
  @@index([createdById])
  @@map("class_schedules")
}

// ---------------------------------------------------------------------------
// MOD-06 — lessons and attendance (roadmap §4f; owner decisions D-R30..D-R34,
// CH-0094). Subset of master doc 6.7.4-C: no lesson materials or recordings
// (D-R30), no meeting provider fields (MOD-15). Teacher and room
// double-booking between non-cancelled lessons is refused by two EXCLUDE
// constraints in SQL (D-R34; extension `btree_gist` since CH-0092), which
// Prisma cannot express. Every write on `lessons` goes through MOD-06's
// service (D-R31) — MOD-07 generates lessons from weekly slots through it.
// ---------------------------------------------------------------------------

enum DeliveryMode {
  in_person
  live_online
  recorded
  hybrid

  @@map("delivery_mode")
}

enum LessonStatus {
  scheduled
  in_progress
  completed
  cancelled

  @@map("lesson_status")
}

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@map("attendance_status")
}

/// An actual session of a class at a point in time — generated from a weekly
/// slot (MOD-07-T05) or created by hand. `in_progress` is in the enum but
/// unused in the first version (D-R33: manual complete/cancel/restore).
model Lesson {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId            String       @map("class_id") @db.Uuid
  syllabusItemId     String?      @map("syllabus_item_id") @db.Uuid
  /// The weekly slot this lesson was generated from, if any.
  scheduleId         String?      @map("schedule_id") @db.Uuid
  roomId             String?      @map("room_id") @db.Uuid
  /// One of the class's teachers (service rule); the lead teacher by default
  /// at creation — a snapshot that does not follow later reassignments.
  teacherUserId      String?      @map("teacher_user_id") @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  title              Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  description        Json?
  deliveryMode       DeliveryMode @default(in_person) @map("delivery_mode")
  /// Instants (timestamptz); the academy's or the branch's zone is for display only.
  startsAt           DateTime     @map("starts_at") @db.Timestamptz(6)
  /// > starts_at (CHECK in SQL).
  endsAt             DateTime     @map("ends_at") @db.Timestamptz(6)
  status             LessonStatus @default(scheduled)
  /// A pasted link, https:// only (CHECK in SQL); providers come with MOD-15.
  meetingUrl         String?      @map("meeting_url")
  cancellationReason String?      @map("cancellation_reason")
  attendanceTakenAt  DateTime?    @map("attendance_taken_at") @db.Timestamptz(6)
  createdById        String?      @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  syllabusItem CourseSyllabusItem? @relation(fields: [syllabusItemId], references: [id], onDelete: SetNull)
  schedule     ClassSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  room         Room?               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  teacher      User?               @relation("LessonTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendance   AttendanceRecord[]
  /// MOD-08: assignments linked to this lesson (the link is cleared when the lesson goes).
  assignments  Assignment[]
  /// MOD-09: exams held in this lesson (the link is cleared when the lesson goes).
  exams        Exam[]

  @@index([classId, startsAt])
  @@index([teacherUserId, startsAt])
  @@index([roomId, startsAt])
  @@index([status, startsAt])
  @@index([syllabusItemId])
  @@index([scheduleId])
  @@index([createdById])
  @@map("lessons")
}

/// One student's attendance at one lesson, written as an upsert by the
/// teacher (D-R33). The enrollment is checked by the service — no column.
model AttendanceRecord {
  lessonId      String           @map("lesson_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        AttendanceStatus
  /// > 0 and only with status `late` (CHECKs in SQL).
  minutesLate   Int?             @map("minutes_late") @db.SmallInt
  /// The teacher's note — never shown to the student or the guardian (D-R32).
  note          String?
  recordedById  String?          @map("recorded_by") @db.Uuid
  recordedAt    DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student    User   @relation("AttendanceStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  recordedBy User?  @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@id([lessonId, studentUserId])
  @@index([studentUserId])
  @@index([recordedById])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// MOD-08 — assignments and submissions (roadmap §4g; owner decisions
// D-R35..D-R40, CH-0114). Subset of master doc 6.7.4-D: no submission files
// (D-R35 — no `files` table before MOD-15; a submission carries text and/or
// an https link) and no gradebook entries (D-R36 — MOD-09 reads the graded
// submissions). Manual assignment states `draft → open → closed` (D-R37); one
// row per attempt up to `max_attempts` (D-R38); a teacher grades or returns a
// submission (D-R39). `score <= max_score` spans two tables and is a service
// rule; the single-table CHECKs are hand-written SQL in the migration.
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  draft
  open
  closed
  grading
  graded

  @@map("assignment_status")
}

enum SubmissionStatus {
  submitted
  graded
  returned

  @@map("submission_status")
}

/// A piece of work set for a class, optionally tied to one of its lessons.
/// `grading`/`graded` are in the enum but unused in the first version
/// (D-R37 — the grading progress is derived from the submissions).
model Assignment {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId            String           @map("class_id") @db.Uuid
  lessonId           String?          @map("lesson_id") @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  title              Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  instructions       Json?
  /// > 0 (CHECK in SQL); locked once a submission exists (service rule).
  maxScore           Decimal          @map("max_score") @db.Decimal(6, 2)
  /// Weight in the final grade — read by MOD-09 (D-R36); >= 0 (CHECK in SQL).
  weight             Decimal?         @db.Decimal(5, 2)
  status             AssignmentStatus @default(draft)
  /// Set by `publish`; NOT NULL for every status but `draft` (CHECK in SQL).
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(6)
  /// Set by `close`, cleared by `reopen`.
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(6)
  /// Instant (timestamptz); the display zone is the room's branch or the academy's (D-R41).
  dueAt              DateTime?        @map("due_at") @db.Timestamptz(6)
  allowLate          Boolean          @default(false) @map("allow_late")
  /// 0..100 and only with `allow_late` (CHECKs in SQL); applied by MOD-09 (D-R36).
  latePenaltyPercent Decimal?         @map("late_penalty_percent") @db.Decimal(5, 2)
  /// >= 1 (CHECK in SQL); a `returned` submission grants one more attempt (D-R39).
  maxAttempts        Int              @default(1) @map("max_attempts") @db.SmallInt
  createdById        String?          @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson      Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([classId, dueAt])
  @@index([status, dueAt])
  @@index([lessonId])
  @@index([createdById])
  @@map("assignments")
}

/// One attempt of one student on one assignment (D-R38): text and/or an
/// https link (D-R35), later graded (score + feedback) or returned for
/// rework (feedback required) by a teacher (D-R39).
model AssignmentSubmission {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  assignmentId  String           @map("assignment_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  /// >= 1 (CHECK in SQL); unique per (assignment, student).
  attemptNo     Int              @default(1) @map("attempt_no") @db.SmallInt
  submittedAt   DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// Submitted after `due_at` under `allow_late` (service rule).
  isLate        Boolean          @default(false) @map("is_late")
  textAnswer    String?          @map("text_answer")
  /// https:// only; text or link is required (CHECKs in SQL).
  linkUrl       String?          @map("link_url")
  status        SubmissionStatus @default(submitted)
  /// >= 0 and only for `graded` (CHECKs in SQL); <= max_score is a service rule.
  score         Decimal?         @db.Decimal(6, 2)
  /// Required for `returned` (CHECK in SQL).
  feedback      String?
  gradedById    String?          @map("graded_by") @db.Uuid
  /// Set when graded or returned, NULL while `submitted` (CHECK in SQL).
  gradedAt      DateTime?        @map("graded_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("SubmissionStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentUserId, attemptNo], map: "uq_assignment_submissions_attempt")
  @@index([studentUserId])
  @@index([gradedById])
  @@index([assignmentId, status])
  @@map("assignment_submissions")
}

// ---------------------------------------------------------------------------
// MOD-09 — exams and grades (roadmap §4h; owner decisions D-R42..D-R49,
// CH-0123). First version (D-R42): exams whose results a teacher records — no
// online exams yet (question banks, exam questions, attempts and answers are a
// second phase whose counted result will be written into `exam_results`);
// academy grade schemes whose bands are defined by their lower bound (D-R46);
// and the per-enrollment final grade fixed for a whole class (D-R45) as a
// snapshot with its breakdown (D-R44). No `gradebook_entries`: the gradebook
// is computed on read from the assignments (MOD-08) and the exams. Rules that
// span two tables (a result's score <= the exam's max score) are service
// rules; the single-table CHECKs and the "one default scheme" partial unique
// index are hand-written SQL in the migration.
// ---------------------------------------------------------------------------

enum ExamType {
  quiz
  midterm
  final
  project
  oral
  practice
  other

  @@map("exam_type")
}

/// Manual states (D-R47): `scheduled` shows the exam to the learners,
/// `published` shows its results too. Online states come with the second phase.
enum ExamStatus {
  draft
  scheduled
  published

  @@map("exam_status")
}

enum ExamResultStatus {
  scored
  absent
  excused

  @@map("exam_result_status")
}

/// An assessment of a class whose results a teacher records (D-R42) — a
/// written quiz, a final, a project, an oral exam… — optionally held in one of
/// the class's lessons. Its weight enters the final grade (D-R43).
model Exam {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId         String             @map("class_id") @db.Uuid
  lessonId        String?            @map("lesson_id") @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  title           Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  description     Json?
  type            ExamType
  status          ExamStatus         @default(draft)
  /// Instant (timestamptz) the exam takes place; the display zone is the room's branch or the academy's (D-R41).
  scheduledAt     DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  /// 1..720 (CHECK in SQL).
  durationMinutes Int?               @map("duration_minutes") @db.SmallInt
  /// > 0 (CHECK in SQL); locked once a result exists (service rule).
  maxScore        Decimal            @map("max_score") @db.Decimal(6, 2)
  /// 0..max_score (CHECK in SQL); informational — passing the course comes from the grade scheme.
  passScore       Decimal?           @map("pass_score") @db.Decimal(6, 2)
  /// Weight in the final grade (D-R43); NULL = informational; >= 0 (CHECK in SQL).
  weight          Decimal?           @db.Decimal(5, 2)
  /// When the results were published; NOT NULL exactly for `published` (CHECK in SQL).
  publishedAt     DateTime?          @map("published_at") @db.Timestamptz(6)
  createdById     String?            @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// MOD-09 phase 2 (D-R150): `manual` = the teacher records the results (every exam before
  /// the phase); `online` = the learners take it on the platform. Changes only in a draft.
  delivery        ExamDelivery       @default(manual)
  /// Online only (D-R152): the window is `scheduled_at` (opens) .. `closes_at`; NULL for a manual exam (CHECK in SQL).
  closesAt        DateTime?          @map("closes_at") @db.Timestamptz(6)
  /// Online only (D-R153): 1..20 attempts per student (CHECK in SQL); 1 for a manual exam.
  attemptsAllowed Int                @default(1) @map("attempts_allowed") @db.SmallInt
  /// Online only (D-R156): when a learner sees their own score; `on_publish` for a manual exam (CHECK in SQL).
  resultsRelease  ExamResultsRelease @default(on_publish) @map("results_release")
  /// Online only (D-R157): correct answers and explanations after the window closed, once the result is visible; false for a manual exam.
  revealAnswers   Boolean            @default(false) @map("reveal_answers")

  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  results   ExamResult[]
  /// MOD-09 phase 2: the linked bank questions (frozen at `schedule`) and the learners' attempts.
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([classId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([lessonId])
  @@index([createdById])
  @@map("exams")
}

/// The counted result of one student in one exam (D-R42/D-R47): a score, or
/// absent (counts 0 in the final grade) or excused (left out of it — D-R45).
model ExamResult {
  examId        String           @map("exam_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        ExamResultStatus
  /// >= 0 and exactly for `scored` (CHECKs in SQL); <= the exam's max score is a service rule.
  score         Decimal?         @db.Decimal(6, 2)
  feedback      String?
  recordedById  String?          @map("recorded_by") @db.Uuid
  recordedAt    DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// MOD-09 phase 2 (D-R160): `manual` = recorded on the results sheet; `online` = the counted
  /// result of the student's finished attempts, written by the grading engine (always `scored` — CHECK in SQL).
  source        ExamResultSource @default(manual)

  exam       Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  student    User  @relation("ExamResultStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  recordedBy User? @relation("ExamResultRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@id([examId, studentUserId])
  @@index([studentUserId])
  @@index([recordedById])
  @@map("exam_results")
}

/// An academy grade scheme (D-R46): bands by their lower bound; exactly one
/// default (partial unique index in SQL), and a default scheme is active.
model GradeScheme {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name      Json
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bands       GradeSchemeBand[]
  /// Restrict: a scheme used by a final grade is deactivated, not deleted.
  finalGrades FinalGrade[]

  @@map("grade_schemes")
}

/// One band of a grade scheme: it covers the percentages from its
/// `min_percent` up to the next band's (no max, so no gap and no overlap). The
/// service requires a band at 0 and that every band above a passing one passes.
model GradeSchemeBand {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schemeId   String  @map("scheme_id") @db.Uuid
  /// 0..100 (CHECK in SQL); unique inside the scheme.
  minPercent Decimal @map("min_percent") @db.Decimal(5, 2)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  label      Json
  /// Optional short code (A, B+, …); trimmed and not blank (CHECK in SQL).
  letter     String? @db.VarChar(4)
  isPass     Boolean @map("is_pass")

  scheme GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, minPercent], map: "uq_grade_scheme_bands_min")
  @@map("grade_scheme_bands")
}

/// The final grade fixed for one enrollment when its class is finalized
/// (D-R45): the percentage, the band of the scheme used and the breakdown of
/// the components at that moment (D-R44) — what a certificate (MOD-10) and the
/// transcript build on. Withdrawing the class's final grades deletes the rows.
model FinalGrade {
  enrollmentId  String   @id @map("enrollment_id") @db.Uuid
  /// 0..100 with two decimals (CHECK in SQL).
  percent       Decimal  @db.Decimal(5, 2)
  schemeId      String   @map("scheme_id") @db.Uuid
  /// The band's label at finalization (snapshot); `ar` is required (CHECK in SQL).
  bandLabel     Json     @map("band_label")
  bandLetter    String?  @map("band_letter") @db.VarChar(4)
  isPass        Boolean  @map("is_pass")
  /// JSON array of the components at finalization (CHECK in SQL).
  breakdown     Json
  finalizedById String?  @map("finalized_by") @db.Uuid
  finalizedAt   DateTime @default(now()) @map("finalized_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment  Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  scheme      GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  finalizedBy User?       @relation("FinalGradeFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)

  @@index([schemeId])
  @@index([finalizedById])
  @@map("final_grades")
}

// MOD-10 — certificates (roadmap §4h.10; owner decisions D-R50..D-R57,
// CH-0174). First version (D-R50): a completion certificate per completed
// enrollment with a passing, non-stale final grade (MOD-09), keeping an
// immutable snapshot that the frontend prints — no template table, no stored
// PDF. Serials `PREFIX-YYYY-NNNNN` come from `number_sequences` (D-R53, shared
// with MOD-11 later); at most one issued certificate per enrollment (partial
// unique in SQL — D-R55); certificates are never deleted, only revoked.

enum CertificateStatus {
  issued
  revoked

  @@map("certificate_status")
}

/// Readable running numbers (6.7.4-F): one row per key and period, locked
/// FOR UPDATE inside the transaction that takes the next value.
model NumberSequence {
  /// e.g. `certificate`; trimmed and non-empty (CHECK in SQL).
  key       String   @db.VarChar(32)
  /// `''` or a period such as `2026`.
  period    String   @default("") @db.VarChar(8)
  /// The last value handed out; >= 0 (CHECK in SQL).
  lastValue BigInt   @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([key, period])
  @@map("number_sequences")
}

model Certificate {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// `PREFIX-YYYY-NNNNN` (D-R53).
  serial           String            @unique @db.VarChar(32)
  /// Random base32 code for the public verification (D-R56).
  verificationCode String            @unique @map("verification_code") @db.VarChar(32)
  enrollmentId     String            @map("enrollment_id") @db.Uuid
  classId          String            @map("class_id") @db.Uuid
  courseId         String            @map("course_id") @db.Uuid
  studentUserId    String            @map("student_user_id") @db.Uuid
  status           CertificateStatus @default(issued)
  /// The final grade at issuance: 0..100 (CHECK in SQL).
  percent          Decimal           @db.Decimal(5, 2)
  /// The band's label at issuance; `ar` is required (CHECK in SQL).
  bandLabel        Json              @map("band_label")
  bandLetter       String?           @map("band_letter") @db.VarChar(4)
  /// Student, course, class, academy and dates at issuance — what is printed (D-R50).
  snapshot         Json
  issuedAt         DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById       String?           @map("issued_by") @db.Uuid
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedById      String?           @map("revoked_by") @db.Uuid
  revokeReason     String?           @map("revoke_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Restrict)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  student    User       @relation("CertificateStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  issuedBy   User?      @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedBy  User?      @relation("CertificateRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([classId])
  @@index([courseId])
  @@index([studentUserId])
  @@index([status, issuedAt])
  @@index([issuedById])
  @@index([revokedById])
  @@map("certificates")
}

// MOD-11 — payments and installments (roadmap §4i; owner decisions
// D-R58..D-R65, CH-0181). First version: fee plans as templates whose lines
// and installment shares are copied into an invoice (D-R60); invoices with
// lines, one invoice-level discount and 1..24 installments (D-R61/D-R62/D-R64);
// manual payments with receipts, reversed instead of edited (D-R63); one
// academy currency stored on each invoice and payment (D-R59 = D15). Paid
// installments, partial payment and overdue are computed on read (D-R62);
// `invoices.paid_amount` is kept in the payment's transaction. No online
// payment, tax or refund record yet.

enum InvoiceStatus {
  draft
  issued
  cancelled

  @@map("invoice_status")
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  cheque
  other

  @@map("payment_method")
}

enum PaymentStatus {
  completed
  reversed

  @@map("payment_status")
}

model FeePlan {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Localized name; `ar` is required (CHECK in SQL).
  name         Json
  /// The course or the class the plan prices — one at most (CHECK in SQL); neither = a general plan.
  courseId     String?  @map("course_id") @db.Uuid
  classId      String?  @map("class_id") @db.Uuid
  /// [{ description { ar, en?, tr? }, amount }] — 1..50 positive amounts (service rule; array CHECK in SQL).
  lines        Json
  /// [{ percent, dueOffsetDays }] — 1..24 shares summing to 100 (service rule; array CHECK in SQL).
  installments Json
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course        Course?   @relation("FeePlanCourse", fields: [courseId], references: [id], onDelete: Cascade)
  class         Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// MOD-19: the courses charging this plan for an enrollment request (D-R122).
  pricedCourses Course[]  @relation("CourseEnrollmentFeePlan")
  createdBy     User?     @relation("FeePlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invoices      Invoice[]

  @@index([courseId])
  @@index([classId])
  @@index([createdById])
  @@map("fee_plans")
}

model Invoice {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// `INV-YYYY-NNNNN`, given at issuance (D-R61); null for a draft (CHECK in SQL).
  number         String?       @unique @db.VarChar(32)
  studentUserId  String        @map("student_user_id") @db.Uuid
  enrollmentId   String?       @map("enrollment_id") @db.Uuid
  feePlanId      String?       @map("fee_plan_id") @db.Uuid
  status         InvoiceStatus @default(draft)
  /// The academy currency at creation (D-R59); ISO 4217 (CHECK in SQL).
  currency       String        @db.Char(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason String?       @map("discount_reason")
  /// subtotal − discount (CHECK in SQL).
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  /// Sum of the completed payments, kept in the payment's transaction (D-R62); 0..total (CHECK in SQL).
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  /// Internal note, never shown to learners.
  notes          String?
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(6)
  issuedById     String?       @map("issued_by") @db.Uuid
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById  String?       @map("cancelled_by") @db.Uuid
  cancelReason   String?       @map("cancel_reason")
  createdById    String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student      User                 @relation("InvoiceStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  enrollment   Enrollment?          @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  feePlan      FeePlan?             @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  issuedBy     User?                @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  cancelledBy  User?                @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  installments InvoiceInstallment[]
  payments     Payment[]

  @@index([studentUserId])
  @@index([enrollmentId])
  @@index([feePlanId])
  @@index([status, issuedAt])
  @@index([issuedById])
  @@index([cancelledById])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  sortOrder   Int     @map("sort_order") @db.SmallInt
  /// Localized description; `ar` is required (CHECK in SQL).
  description Json
  /// > 0 (CHECK in SQL).
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sortOrder], map: "uq_invoice_lines_order")
  @@map("invoice_lines")
}

model InvoiceInstallment {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  /// 1..24 (CHECK in SQL).
  seq       Int      @db.SmallInt
  /// > 0 (CHECK in SQL); the installments of an invoice sum to its total (service rule).
  amount    Decimal  @db.Decimal(12, 2)
  dueOn     DateTime @map("due_on") @db.Date

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, seq], map: "uq_invoice_installments_seq")
  @@map("invoice_installments")
}

model Payment {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The receipt `RCPT-YYYY-NNNNN` (D-R63).
  number        String        @unique @db.VarChar(32)
  invoiceId     String        @map("invoice_id") @db.Uuid
  /// > 0 and within the balance (CHECK + service rule).
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @db.Char(3)
  method        PaymentMethod
  status        PaymentStatus @default(completed)
  paidAt        DateTime      @map("paid_at") @db.Timestamptz(6)
  reference     String?
  payerName     String?       @map("payer_name")
  notes         String?
  recordedById  String?       @map("recorded_by") @db.Uuid
  reversedAt    DateTime?     @map("reversed_at") @db.Timestamptz(6)
  reversedById  String?       @map("reversed_by") @db.Uuid
  reverseReason String?       @map("reverse_reason")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedBy User?   @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status, paidAt])
  @@index([recordedById])
  @@index([reversedById])
  @@map("payments")
}

// MOD-12 — notifications (roadmap §4j; owner decisions D-R79..D-R86, CH-0200).
// First version: one row per in-app notification, written inside the
// transaction of the write that causes it (D-R82). The state of its e-mail
// copy lives in the same row instead of a row per channel, so the inbox never
// shows a notification twice. Title and body are rendered in the recipient's
// language at creation (D-R83). E-mail is switched off per category (D-R84) —
// a missing preference row means "on"; in-app notifications are always on.
// Manual announcements keep their audience and fan out into notifications
// (D-R85). No template table, no device tokens and no outbox yet.

enum NotificationCategory {
  lessons
  assignments
  exams
  grades
  finance
  announcements
  /// MOD-19 (D-R128): requests, activations and rejections of enrollments.
  enrollments

  @@map("notification_category")
}

/// E-mail copy of a notification: `none` = no e-mail was due (unverified
/// address, category switched off, announcement without e-mail); `queued` =
/// waiting for the dispatcher; `sent` / `failed` = the transport's verdict;
/// `skipped` = no transport is configured (`MAIL_TRANSPORT=none`).
enum NotificationEmailStatus {
  none
  queued
  sent
  failed
  skipped

  @@map("notification_email_status")
}

model Notification {
  id              String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientUserId String                  @map("recipient_user_id") @db.Uuid
  /// The event, e.g. `assignment.published` — the list lives in code (D-R80); a lower-case dotted key (CHECK in SQL).
  eventKey        String                  @map("event_key") @db.VarChar(64)
  category        NotificationCategory
  /// Rendered in the recipient's language at creation (D-R83); not blank (CHECK in SQL).
  title           String
  /// Not blank (CHECK in SQL).
  body            String
  /// The frontend path (`link`) and ids only — a JSON object (CHECK in SQL).
  data            Json                    @default("{}")
  /// The student the event is about (a guardian's copy names the child); cleared if that user goes.
  studentUserId   String?                 @map("student_user_id") @db.Uuid
  /// Set exactly for the `announcements` category (CHECK in SQL).
  announcementId  String?                 @map("announcement_id") @db.Uuid
  readAt          DateTime?               @map("read_at") @db.Timestamptz(6)
  emailStatus     NotificationEmailStatus @default(none) @map("email_status")
  /// Set exactly for `sent` (CHECK in SQL).
  emailSentAt     DateTime?               @map("email_sent_at") @db.Timestamptz(6)
  /// The provider's message id; only for `sent` (CHECK in SQL).
  emailMessageId  String?                 @map("email_message_id")
  /// A reason code, never the provider's message: required for `failed`, optional for `skipped`, absent otherwise (CHECK in SQL).
  emailFailure    String?                 @map("email_failure") @db.VarChar(32)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient    User          @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  student      User?         @relation("NotificationStudent", fields: [studentUserId], references: [id], onDelete: SetNull)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  /// The inbox: newest first by the UUIDv7 id (keyset). Two partial indexes
  /// (unread counter, queued e-mails) are hand-written in the migration.
  @@index([recipientUserId, id(sort: Desc)])
  @@index([studentUserId])
  @@index([announcementId])
  @@map("notifications")
}

/// E-mail switch per category (D-R84). A missing row means the e-mail of that
/// category is on.
model NotificationPreference {
  userId       String               @map("user_id") @db.Uuid
  category     NotificationCategory
  emailEnabled Boolean              @map("email_enabled")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// A manual announcement (D-R85): what was sent, to whom and to how many. Its
/// notifications point back to it; it is never edited or withdrawn.
model Announcement {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  senderUserId   String?  @map("sender_user_id") @db.Uuid
  /// `{ kind: class|academy, classId?, students?, guardians?, teachers?, roleKeys? }` as requested — an object with a known kind (CHECK in SQL).
  audience       Json
  /// The class of a class announcement (never set for an academy one — CHECK in SQL); cleared if the class goes, the audience keeps its id.
  classId        String?  @map("class_id") @db.Uuid
  /// 1..200 characters, not blank (CHECK in SQL).
  title          String
  /// 1..4,000 characters, not blank (CHECK in SQL).
  body           String
  sendEmail      Boolean  @default(false) @map("send_email")
  /// Recipients at sending time; >= 0 (CHECK in SQL).
  recipientCount Int      @map("recipient_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sender        User?          @relation("AnnouncementSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  class         Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([senderUserId, id(sort: Desc)])
  @@index([classId])
  @@map("announcements")
}

// MOD-01-H06 — MFA (TOTP) (roadmap §4n; decisions D-R105..D-R112, CH-0279).
// The secret and the pending setup live in `users` (D-R108); the login
// challenge is a `verification_tokens` row with purpose `mfa_challenge`. Here:
// the one-time recovery codes, stored as their SHA-256 only (lower-case hex —
// CHECK in SQL). A used code keeps its row with `usedAt`; regenerating the
// codes replaces the whole set.

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the code, 64 lower-case hex characters (CHECK in SQL); never the code itself.
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  /// Set once when the code is spent; never before `createdAt` (CHECK in SQL).
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// MOD-20 — «My School»: the course curriculum as levels and lessons, the
// lesson content, and each learner's progress (roadmap §4q; decisions
// D-R130..D-R139, ADR-078). A course's curriculum is its syllabus items
// (MOD-04) grouped into ordered levels (`course_sections` — «المستوى الأول»,
// …), distinct from the catalog's `levels` (MOD-04: a course's difficulty).
// Progress is stored per (student, lesson) only; level and course progress,
// the last lesson opened and the completion of a course are computed on read
// (ADR-078). Content is referenced by absolute https URL — there is no file
// storage — and text is plain text, never HTML (D-R131).

enum LearningItemKind {
  text
  video
  audio
  pdf
  image
  file
  live

  @@map("learning_item_kind")
}

enum LearningStatus {
  in_progress
  completed

  @@map("learning_status")
}

/// How a stored completion came about: the learner's explicit action, or enough of the media played (D-R134).
enum LearningCompletionSource {
  manual
  playback

  @@map("learning_completion_source")
}

model CourseSection {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  /// Position of the level in its course (0 first); deferred unique per course (ADR-046 — swaps inside one transaction).
  sortOrder        Int      @map("sort_order") @db.SmallInt
  /// Optional localized title `{ ar, en?, tr? }` shown after «المستوى N»; `ar` required when present (CHECK in SQL).
  title            Json?
  description      Json?
  /// MOD-20 (D-R145): the level opens N days after its class starts (0..365, in the academy's zone); null = open at once.
  releaseAfterDays Int?     @map("release_after_days") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  CourseSyllabusItem[]

  @@unique([courseId, sortOrder], map: "uq_course_sections_course_order")
  @@map("course_sections")
}

/// One learner's progress on one lesson (no row = not started). Written only by the learner's own requests (D-R134).
model LearningProgress {
  studentUserId        String                    @map("student_user_id") @db.Uuid
  syllabusItemId       String                    @map("syllabus_item_id") @db.Uuid
  /// The lesson's course (kept equal to it by the composite FK) for the per-course reads.
  courseId             String                    @map("course_id") @db.Uuid
  status               LearningStatus
  /// Exactly for `completed` (CHECK in SQL).
  completionSource     LearningCompletionSource? @map("completion_source")
  firstOpenedAt        DateTime                  @map("first_opened_at") @db.Timestamptz(6)
  lastOpenedAt         DateTime                  @map("last_opened_at") @db.Timestamptz(6)
  /// Exactly for `completed` (CHECK in SQL); never cleared — reviewing a lesson keeps it complete.
  completedAt          DateTime?                 @map("completed_at") @db.Timestamptz(6)
  /// Resume point of a played media lesson, in whole seconds.
  positionSeconds      Int?                      @map("position_seconds")
  /// The media length the coverage was measured against (the authored duration).
  mediaDurationSeconds Int?                      @map("media_duration_seconds")
  /// Seconds of the media actually played: the length of `watched_ranges`, never the furthest point reached.
  watchedSeconds       Int                       @default(0) @map("watched_seconds")
  /// Merged played intervals `[[start, end], …]` in whole seconds (an array — CHECK in SQL).
  watchedRanges        Json                      @default("[]") @map("watched_ranges")
  /// The previous playback save — the clock the credited coverage is capped by.
  lastPlaybackAt       DateTime?                 @map("last_playback_at") @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student      User               @relation("LearningProgressStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  syllabusItem CourseSyllabusItem @relation(fields: [syllabusItemId, courseId], references: [id, courseId], onDelete: Restrict)
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([studentUserId, syllabusItemId])
  @@index([syllabusItemId, courseId])
  @@index([courseId])
  @@index([studentUserId, courseId, lastOpenedAt(sort: Desc)])
  @@map("learning_progress")
}

// ---------------------------------------------------------------------------
// MOD-09 phase 2 — online exams and auto-grading (roadmap §4r; decisions
// D-R150..D-R166; GitHub issue #210). Six tables beside the five of the first
// phase, which keep their shape: an exam stays `draft → scheduled → published`
// (D-R47) and gains a `delivery` — `manual` for every exam that existed before.
// The teacher writes questions into banks, links them to an online exam with
// an order and points, and `schedule` freezes a full copy of each one in
// `exam_questions.snapshot`: attempts are served and graded from that copy
// only, so editing a bank question later never changes an exam that is being
// taken or a result already counted (D-R158). A finished attempt writes the
// student's counted result into `exam_results` (D-R160) — the gradebook, «my
// exams», «my grades», the reports and the certificates read an online exam
// exactly like a manual one. The single-table CHECKs and the two partial
// indexes of `exam_attempts` are hand-written SQL in the migration; rules that
// span rows or tables (one correct option, points summing to the maximum
// score, the attempt limit, the window) are service rules under a row lock.
// ---------------------------------------------------------------------------

/// How an exam's results come to be (D-R150).
enum ExamDelivery {
  manual
  online

  @@map("exam_delivery")
}

/// When a learner sees their own score in an online exam (D-R156).
enum ExamResultsRelease {
  on_publish
  on_submit

  @@map("exam_results_release")
}

/// Who wrote a counted result (D-R160).
enum ExamResultSource {
  manual
  online

  @@map("exam_result_source")
}

/// The auto-graded types of the first online version (D-R163). Later types
/// are added by `ALTER TYPE … ADD VALUE`; answers are typed JSON, so they need
/// no new column.
enum QuestionType {
  single_choice
  true_false

  @@map("question_type")
}

/// `draft` may be incomplete; `ready` passes every rule of its type and can be
/// linked to an exam; `archived` is kept for the exams that used it (D-R164).
enum QuestionStatus {
  draft
  ready
  archived

  @@map("question_status")
}

enum QuestionDifficulty {
  easy
  medium
  hard

  @@map("question_difficulty")
}

/// `submitted` by the student, `timed_out` by the server at the deadline —
/// both are finished and graded (D-R154).
enum ExamAttemptStatus {
  in_progress
  submitted
  timed_out

  @@map("exam_attempt_status")
}

/// A teacher's collection of questions, optionally filed under a course.
/// Visible to its author, to the teachers of a class of its course and to the
/// holders of `classes.manage` — always with `questions.manage` (D-R162).
model QuestionBank {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId    String?  @map("course_id") @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name        Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  description Json?
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course    Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("QuestionBankCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Deleted with the bank — which the service allows only while no exam links any of them.
  questions Question[]

  @@index([courseId])
  @@index([createdById])
  @@map("question_banks")
}

/// One question of a bank. A `single_choice` question has 2..10 options with
/// exactly one correct (service rule); a `true_false` question has no options
/// and its key in `correct_boolean`. The correct answer never leaves through a
/// learner's route before the exam's release rules allow it.
model Question {
  id             String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bankId         String              @map("bank_id") @db.Uuid
  /// Fixed at creation.
  type           QuestionType
  status         QuestionStatus      @default(draft)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  prompt         Json
  /// Localized explanation of the answer or NULL (CHECK in SQL).
  explanation    Json?
  /// Default points when the question is linked to an exam; > 0 (CHECK in SQL).
  points         Decimal             @default(1) @db.Decimal(6, 2)
  /// The key of a `true_false` question; NULL for any other type, NOT NULL once such a question is `ready` (CHECKs in SQL).
  correctBoolean Boolean?            @map("correct_boolean")
  difficulty     QuestionDifficulty?
  /// Free topic labels, at most 10 (CHECK in SQL); trimmed and lower-cased by the service.
  tags           String[]            @default([])
  createdById    String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bank          QuestionBank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  options       QuestionOption[]
  /// Restrict: a question linked to an exam is archived, not deleted.
  examQuestions ExamQuestion[]

  @@index([bankId, status])
  @@index([createdById])
  @@index([tags], type: Gin)
  @@map("questions")
}

/// One choice of a `single_choice` question. The service replaces a question's
/// options as a whole, so their ids are not stable — nothing refers to them:
/// an exam keeps its own frozen copy.
model QuestionOption {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  text       Json
  isCorrect  Boolean @map("is_correct")
  /// Position inside the question (0 first).
  sortOrder  Int     @map("sort_order") @db.SmallInt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder], map: "uq_question_options_order")
  @@map("question_options")
}

/// A bank question linked to an online exam with its position and points.
/// While the exam is a draft the content is the bank's; `schedule` writes the
/// frozen copy the learners are served and graded from (D-R158), `unschedule`
/// (only without attempts) clears it.
model ExamQuestion {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  examId     String   @map("exam_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  /// Position inside the exam (0 first).
  sortOrder  Int      @map("sort_order") @db.SmallInt
  /// > 0 (CHECK in SQL); the points of every question of the exam sum to its `max_score` at `schedule` (D-R159).
  points     Decimal  @db.Decimal(6, 2)
  /// `{ type, prompt, explanation, options: [{ id, text, isCorrect }], correctBoolean }` once scheduled; NULL in a draft (CHECK in SQL).
  snapshot   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam     Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers  ExamAnswer[]

  @@unique([examId, questionId], map: "uq_exam_questions_question")
  @@unique([examId, sortOrder], map: "uq_exam_questions_order")
  @@index([questionId])
  @@map("exam_questions")
}

/// One attempt of one student at an online exam. The server fixes its
/// deadline at the start (`expires_at` = start + the exam's duration, never
/// past the window's end) and closes it itself when the time is up (D-R152,
/// D-R154). At most one attempt is in progress per student and exam (partial
/// unique index in SQL). Finishing grades it once, under its row lock.
model ExamAttempt {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  examId        String            @map("exam_id") @db.Uuid
  studentUserId String            @map("student_user_id") @db.Uuid
  /// 1..20 (CHECK in SQL); unique per student and exam.
  attemptNo     Int               @map("attempt_no") @db.SmallInt
  status        ExamAttemptStatus @default(in_progress)
  /// Written by the application clock together with `expires_at`.
  startedAt     DateTime          @map("started_at") @db.Timestamptz(6)
  /// The server's deadline; after `started_at` (CHECK in SQL).
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  /// NOT NULL exactly once the attempt is finished (CHECK in SQL).
  submittedAt   DateTime?         @map("submitted_at") @db.Timestamptz(6)
  /// 0..max_score, NOT NULL exactly once finished (CHECKs in SQL).
  score         Decimal?          @db.Decimal(6, 2)
  /// The exam's maximum score when the attempt started; > 0 (CHECK in SQL).
  maxScore      Decimal           @map("max_score") @db.Decimal(6, 2)
  /// The exam's question count when the attempt started; >= 1 (CHECK in SQL).
  questionCount Int               @map("question_count") @db.SmallInt
  /// 0..question_count, NOT NULL exactly once finished (CHECKs in SQL).
  correctCount  Int?              @map("correct_count") @db.SmallInt
  /// The last grading (the first one at the finish, later ones after a key correction — D-R161); NOT NULL exactly once finished.
  gradedAt      DateTime?         @map("graded_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User         @relation("ExamAttemptStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  answers ExamAnswer[]

  @@unique([examId, studentUserId, attemptNo], map: "uq_exam_attempts_no")
  @@index([studentUserId])
  @@map("exam_attempts")
}

/// The student's answer to one question of an attempt. A row exists only while
/// the question is answered (clearing an answer deletes it); the grading
/// columns are filled when the attempt is finished.
model ExamAnswer {
  attemptId      String   @map("attempt_id") @db.Uuid
  examQuestionId String   @map("exam_question_id") @db.Uuid
  /// `{ optionId }` for `single_choice`, `{ value }` for `true_false` — an object (CHECK in SQL), checked against the frozen question by the service.
  response       Json
  /// NULL until the attempt is graded.
  isCorrect      Boolean? @map("is_correct")
  /// >= 0, present exactly with `is_correct` (CHECKs in SQL).
  pointsAwarded  Decimal? @map("points_awarded") @db.Decimal(6, 2)
  answeredAt     DateTime @map("answered_at") @db.Timestamptz(6)

  attempt      ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  @@id([attemptId, examQuestionId])
  @@index([examQuestionId])
  @@map("exam_answers")
}
