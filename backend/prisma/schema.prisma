// Prisma schema for the ArtiCode Academy backend (ADR-014, ADR-020).
//
// One database per academy, so no table carries an academy_id (D2). Models are
// PascalCase and map to snake_case tables/columns (P2); every primary key is a
// UUIDv7 generated inside PostgreSQL 18 (D4). What Prisma cannot express —
// CHECK constraints, the partial unique index of guardian_students and the
// append-only trigger of audit_logs — is written by hand at the end of the
// migration SQL (docs/PROJECT_DOCUMENTATION.md, section 06).
//
// Connection URL: prisma.config.ts for the CLI, ConfigService at runtime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Match the backend's ESM + NodeNext setup (imports end in .js).
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (small, stable sets — P6). Mapped to snake_case PostgreSQL types.
// ---------------------------------------------------------------------------

/// Languages localized text can be stored in; `ar` is the reference language (D1).
enum Locale {
  ar
  en
  tr

  @@map("locale")
}

enum UserStatus {
  invited
  pending
  active
  suspended
  archived

  @@map("user_status")
}

/// Employment category of an employee profile; roles stay independent (D20).
enum EmployeeKind {
  teacher
  staff

  @@map("employee_kind")
}

enum GuardianRelationship {
  father
  mother
  sibling
  legal_guardian
  other

  @@map("guardian_relationship")
}

enum TokenPurpose {
  invitation
  email_verification
  password_reset

  @@map("token_purpose")
}

/// Publication state of a course (MOD-04, D-R13/D-R14): holders of
/// `courses.read` alone see `published` only; `archived` replaces deletion.
enum CourseStatus {
  draft
  published
  archived

  @@map("course_status")
}

// ---------------------------------------------------------------------------
// MOD-02 / MOD-14 — academy identity (exactly one row per database)
// ---------------------------------------------------------------------------

/// Identity and settings of this deployment. The `singleton` column is always
/// true and unique, so the table can hold a single row (CHECK in SQL).
model Academy {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singleton         Boolean  @unique @default(true)
  /// Id of this academy in the central platform database (no FK — separate databases).
  platformAcademyId String?  @unique @map("platform_academy_id") @db.Uuid
  slug              String   @unique @db.VarChar(64)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name              Json
  logoUrl           String?  @map("logo_url")
  defaultLocale     Locale   @default(ar) @map("default_locale")
  /// IANA time zone name, chosen per academy.
  timezone          String
  /// ISO 4217 code, chosen per academy (CHECK in SQL).
  currency          String   @db.Char(3)
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone") @db.VarChar(32)
  /// Free-form settings validated by zod in the service layer (D3).
  settings          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("academy")
}

// ---------------------------------------------------------------------------
// MOD-03 / MOD-01 — people, roles, permissions
// ---------------------------------------------------------------------------

/// One row per person whatever their roles. The kind of user follows from
/// user_roles and the profiles. Every account has a unique login identifier:
/// email or username, both stored lower-case (CHECKs in SQL — D13).
model User {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email              String?    @unique
  username           String?    @unique @db.VarChar(64)
  /// E.164; deliberately not unique — siblings may share a guardian's phone (D21).
  phone              String?    @db.VarChar(32)
  /// argon2id hash; null for invited accounts that have not set a password yet (P9).
  passwordHash       String?    @map("password_hash")
  fullName           String     @map("full_name")
  /// Latin-script name for English certificates and reports (D12).
  fullNameLatin      String?    @map("full_name_latin")
  displayName        String?    @map("display_name")
  avatarUrl          String?    @map("avatar_url")
  /// Preferred language; null means the academy's default_locale.
  locale             Locale?
  status             UserStatus @default(invited)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount   Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete (D7): the row stays because history refers to it.
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  roles                   UserRole[]
  assignedRoles           UserRole[]             @relation("UserRoleAssignedBy")
  studentProfile          StudentProfile?
  employeeProfile         EmployeeProfile?
  /// Links where this user is the guardian.
  guardianOf              GuardianStudent[]      @relation("GuardianStudentGuardian")
  /// Links where this user is the student.
  guardians               GuardianStudent[]      @relation("GuardianStudentStudent")
  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]
  auditLogs               AuditLog[]
  /// Courses this user created (MOD-04); the link is cleared if the user row goes.
  coursesCreated          Course[]               @relation("CourseCreatedBy")
  /// MOD-05: classes this user created, classes they teach (and teacher
  /// assignments they made), their enrollments as a student and the
  /// enrollments they created.
  classesCreated          Class[]                @relation("ClassCreatedBy")
  classTeacherships       ClassTeacher[]         @relation("ClassTeacherTeacher")
  classTeacherAssignments ClassTeacher[]         @relation("ClassTeacherAssignedBy")
  enrollments             Enrollment[]           @relation("EnrollmentStudent")
  enrollmentsCreated      Enrollment[]           @relation("EnrollmentCreatedBy")
  /// MOD-07: weekly slots this user teaches and the slots they created.
  classSchedulesTaught    ClassSchedule[]        @relation("ClassScheduleTeacher")
  classSchedulesCreated   ClassSchedule[]        @relation("ClassScheduleCreatedBy")
  /// MOD-06: lessons this user teaches or created, their attendance as a
  /// student and the attendance records they wrote as a teacher.
  lessonsTaught           Lesson[]               @relation("LessonTeacher")
  lessonsCreated          Lesson[]               @relation("LessonCreatedBy")
  attendanceRecords       AttendanceRecord[]     @relation("AttendanceStudent")
  attendanceRecorded      AttendanceRecord[]     @relation("AttendanceRecordedBy")
  /// MOD-08: assignments this user created, their submissions as a student
  /// and the submissions they graded or returned as a teacher.
  assignmentsCreated      Assignment[]           @relation("AssignmentCreatedBy")
  submissions             AssignmentSubmission[] @relation("SubmissionStudent")
  submissionsGraded       AssignmentSubmission[] @relation("SubmissionGradedBy")

  @@index([phone])
  @@index([status])
  @@map("users")
}

/// System roles (seeded, `isSystem`) and custom roles created by the academy (ROLE-07).
model Role {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                String   @unique @db.VarChar(64)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  label              Json
  description        Json?
  isSystem           Boolean  @default(false) @map("is_system")
  /// Granted automatically on self-registration (usually `student`).
  isDefaultForSignup Boolean  @default(false) @map("is_default_for_signup")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permission catalog seeded from the code (D8). Keys look like `users.read`;
/// obsolete keys are marked `deprecatedAt`, never deleted while referenced.
model Permission {
  key          String    @id @db.VarChar(100)
  module       String    @db.VarChar(32)
  description  Json?
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// A user may hold several roles (teacher + staff). Deleting a role that is
/// still granted fails (Restrict); deleting the user removes the grants.
model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

/// 1:1 with users; created in the same transaction as the `student` role.
model StudentProfile {
  userId        String    @id @map("user_id") @db.Uuid
  studentNumber String?   @unique @map("student_number") @db.VarChar(32)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  enrolledOn    DateTime? @map("enrolled_on") @db.Date
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

/// 1:1 with users for teachers and staff alike (D20). `kind` is the employment
/// category only; what the person may do comes from user_roles. Specialised
/// data can be added later as columns or 1:1 tables.
model EmployeeProfile {
  userId         String       @id @map("user_id") @db.Uuid
  employeeNumber String?      @unique @map("employee_number") @db.VarChar(32)
  kind           EmployeeKind
  jobTitle       String?      @map("job_title")
  specialization String?
  /// Localized text (D1), optional.
  bio            Json?
  hiredOn        DateTime?    @map("hired_on") @db.Date
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind])
  @@map("employee_profiles")
}

/// Guardians ↔ students (n:m). A student has at most one primary guardian
/// (partial unique index in SQL) and cannot be their own guardian (CHECK in SQL).
model GuardianStudent {
  guardianUserId String               @map("guardian_user_id") @db.Uuid
  studentUserId  String               @map("student_user_id") @db.Uuid
  relationship   GuardianRelationship
  isPrimary      Boolean              @default(false) @map("is_primary")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian User @relation("GuardianStudentGuardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianStudentStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@id([guardianUserId, studentUserId])
  @@index([studentUserId])
  @@map("guardian_students")
}

// ---------------------------------------------------------------------------
// MOD-01 — session and one-time tokens (hashes only — P9)
// ---------------------------------------------------------------------------

/// Rotating refresh tokens. All tokens of one login share `familyId`; reuse of
/// a rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the token (hex); the token itself is never stored.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @default(dbgenerated("uuidv7()")) @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One-time tokens: invitations, e-mail verification, password reset.
model VerificationToken {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  /// Purpose-specific data, e.g. the roles an invitation grants.
  metadata   Json?
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Cross-cutting — audit log (append-only through a trigger — D5)
// ---------------------------------------------------------------------------

/// Written by the service layer inside the transaction of the event. Never
/// updated or deleted (trigger in SQL). `metadata` holds no secrets (P11).
model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Dotted event name such as `auth.login.succeeded` or `roles.permissions.changed`.
  action      String   @db.VarChar(64)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  /// Text so that non-UUID keys (e.g. permissions.key) fit.
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// MOD-04 — courses, levels and syllabus (roadmap §4c; owner decisions
// D-R11..D-R14). Subset of master doc 6.7.4-C: no categories, prerequisites,
// price/currency, cover file or soft delete — archiving replaces deletion.
// ---------------------------------------------------------------------------

/// Reference list of course levels managed by the academy (not an enum — 6.7.1).
/// `sort_order` is unique but DEFERRABLE (SQL) so a reorder can swap values
/// inside one transaction.
model Level {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique @db.VarChar(16)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name        Json
  description Json?
  sortOrder   Int      @map("sort_order") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses Course[]

  @@unique([sortOrder], map: "uq_levels_sort_order")
  @@map("levels")
}

/// A course as an educational product. Deleting is allowed only for an unused
/// draft (service rule); otherwise it is archived (D-R14).
model Course {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code          String       @unique @db.VarChar(32)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name          Json
  summary       Json?
  description   Json?
  levelId       String?      @map("level_id") @db.Uuid
  status        CourseStatus @default(draft)
  durationHours Decimal?     @map("duration_hours") @db.Decimal(6, 1)
  sessionsCount Int?         @map("sessions_count") @db.SmallInt
  minAge        Int?         @map("min_age") @db.SmallInt
  maxAge        Int?         @map("max_age") @db.SmallInt
  createdById   String?      @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  level         Level?               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  createdBy     User?                @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  syllabusItems CourseSyllabusItem[]
  /// MOD-05: runs of this course (Restrict — a course with classes cannot be deleted).
  classes       Class[]

  @@index([status])
  @@index([levelId])
  @@index([createdById])
  @@map("courses")
}

/// One ordered item of a course syllabus — the lesson template MOD-06 builds on.
/// `(course_id, sort_order)` is unique but DEFERRABLE (SQL) for reordering.
model CourseSyllabusItem {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  sortOrder        Int      @map("sort_order") @db.SmallInt
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  title            Json
  description      Json?
  estimatedMinutes Int?     @map("estimated_minutes") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// MOD-06: lessons that cover this item (the link is cleared when the item goes).
  lessons Lesson[]

  @@unique([courseId, sortOrder], map: "uq_course_syllabus_items_course_order")
  @@map("course_syllabus_items")
}

// ---------------------------------------------------------------------------
// MOD-05 — classes, class teachers and enrollments (roadmap §4d; owner
// decisions D-R15..D-R18). Subset of master doc 6.7.4-C: no academic terms,
// branches, rooms, price override, enrollment window, final grade or soft
// delete — cancelling replaces deletion (D-R17).
// ---------------------------------------------------------------------------

enum ClassStatus {
  planned
  open
  running
  completed
  cancelled

  @@map("class_status")
}

enum ClassTeacherRole {
  lead
  assistant

  @@map("class_teacher_role")
}

/// `pending` is not used by version 1 (no waitlist — D-R18); it exists so a
/// later waitlist needs no enum migration.
enum EnrollmentStatus {
  pending
  active
  completed
  withdrawn
  cancelled

  @@map("enrollment_status")
}

/// Version 1 writes `admin` only (D-R18); the other sources are reserved for
/// self-enrollment, imports and transfers.
enum EnrollmentSource {
  admin
  self
  import
  transfer

  @@map("enrollment_source")
}

/// A run of a published course for a group of students (D-R15). The status
/// moves through manual actions only (D-R17); only a `planned` class without
/// enrollments can be deleted, any other is cancelled. The enrolled count is
/// computed from `enrollments`, never stored (6.7.4-C).
model Class {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId    String      @map("course_id") @db.Uuid
  code        String      @unique @db.VarChar(32)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name        Json
  /// Hard capacity (D-R18); > 0 (CHECK in SQL).
  capacity    Int         @db.SmallInt
  status      ClassStatus @default(planned)
  /// Display dates only (D-R17); ends_on >= starts_on (CHECK in SQL).
  startsOn    DateTime?   @map("starts_on") @db.Date
  endsOn      DateTime?   @map("ends_on") @db.Date
  notes       String?
  createdById String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy   User?           @relation("ClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  teachers    ClassTeacher[]
  enrollments Enrollment[]
  /// MOD-07: the weekly slots of this class (deleted with it).
  schedules   ClassSchedule[]
  lessons     Lesson[]
  assignments Assignment[]

  @@index([courseId])
  @@index([status])
  @@index([createdById])
  @@map("classes")
}

/// Teachers of a class: at most one `lead` per class (partial unique index
/// `uq_class_teachers_lead` in SQL) and any number of assistants.
model ClassTeacher {
  classId       String           @map("class_id") @db.Uuid
  teacherUserId String           @map("teacher_user_id") @db.Uuid
  role          ClassTeacherRole
  assignedAt    DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById  String?          @map("assigned_by") @db.Uuid

  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User  @relation("ClassTeacherTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("ClassTeacherAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([classId, teacherUserId])
  @@index([teacherUserId])
  @@index([assignedById])
  @@map("class_teachers")
}

/// A student's enrollment in a class — one row per (class, student):
/// enrolling again reactivates the same row. `status` has no default, so
/// every writer states it (version 1 writes `active` directly — D-R18).
model Enrollment {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId          String           @map("class_id") @db.Uuid
  studentUserId    String           @map("student_user_id") @db.Uuid
  status           EnrollmentStatus
  source           EnrollmentSource @default(admin)
  enrolledAt       DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  activatedAt      DateTime?        @map("activated_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)
  withdrawnAt      DateTime?        @map("withdrawn_at") @db.Timestamptz(6)
  withdrawalReason String?          @map("withdrawal_reason")
  createdById      String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class     Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  student   User  @relation("EnrollmentStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  createdBy User? @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([classId, studentUserId], map: "uq_enrollments_class_student")
  @@index([studentUserId])
  @@index([status])
  @@index([createdById])
  @@map("enrollments")
}

// MOD-02 (O8) — branches (D-R19, CH-0087)

/// A site of the academy (D14/D-R19). Rooms point to it since MOD-07-T01
/// (O9); branch-scoped roles come later and classes get no `branch_id` — a
/// class is placed through the rooms of its slots (D-R22, D-R24). At most one main branch (partial unique index in SQL) and a main
/// branch is active (CHECK). No `deleted_at`: like `levels`, a branch is
/// deactivated, or deleted while nothing uses it.
model Branch {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Trimmed and upper-cased by the API; CHECK in SQL.
  code      String   @unique @db.VarChar(16)
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  name      Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  address   Json?
  /// E.164, validated by the API.
  phone     String?  @db.VarChar(32)
  /// IANA time zone when it differs from the academy's; NULL = the academy's.
  timezone  String?
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rooms Room[]

  @@map("branches")
}

// ---------------------------------------------------------------------------
// MOD-07 (O9) — rooms and weekly class schedules (roadmap §4e; owner
// decisions D-R23..D-R29, CH-0090). Subset of master doc 6.7.4: no academic
// terms or holidays (D-R23), no default room or branch on `classes` (D-R24).
// Room and teacher double-booking is refused by two EXCLUDE constraints in
// SQL (extension `btree_gist` — D-R25), which Prisma cannot express.
// ---------------------------------------------------------------------------

enum RoomKind {
  classroom
  lab
  hall
  virtual

  @@map("room_kind")
}

/// A place where a class meets. Without a branch it belongs to the academy's
/// own site. The code is unique inside its branch, and rooms without a branch
/// share one namespace (the unique index is NULLS NOT DISTINCT in SQL). No
/// `deleted_at`: a room is deactivated, or deleted while nothing uses it.
model Room {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  /// Trimmed by the API; CHECK in SQL.
  code      String   @db.VarChar(16)
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  name      Json?
  /// > 0 when set (CHECK in SQL); not checked against class capacity (§4e.1).
  capacity  Int?     @db.SmallInt
  kind      RoomKind @default(classroom)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  schedules ClassSchedule[]
  /// MOD-06: lessons held in this room (a room with lessons cannot be deleted).
  lessons   Lesson[]

  /// Also covers the `branch_id` foreign key (its first column).
  @@unique([branchId, code], map: "uq_rooms_branch_code")
  @@map("rooms")
}

/// One recurring weekly slot of a class: a weekday, a local start/end time
/// (the time zone of the room's branch, else the academy's), an optional room
/// and teacher, and an effective date range (`effective_to` NULL = open-ended).
/// Lessons are generated from it later (T05); the times become timestamptz
/// only then.
model ClassSchedule {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday, like `scheduling.*` (CHECK in SQL).
  weekday       Int       @db.SmallInt
  /// Local wall-clock times; end > start (CHECK in SQL). Adjacent slots do not
  /// overlap (half-open ranges in the EXCLUDE constraints).
  startTime     DateTime  @map("start_time") @db.Time(0)
  endTime       DateTime  @map("end_time") @db.Time(0)
  roomId        String?   @map("room_id") @db.Uuid
  /// One of the class's teachers (service rule — D-R26); NULL = the lead teacher.
  teacherUserId String?   @map("teacher_user_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// Inclusive; NULL = no end; >= effective_from (CHECK in SQL).
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  teacher   User?    @relation("ClassScheduleTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("ClassScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// MOD-06: lessons generated from this slot (the link is cleared when the slot goes).
  lessons   Lesson[]

  @@index([classId])
  @@index([roomId, weekday])
  @@index([teacherUserId, weekday])
  @@index([createdById])
  @@map("class_schedules")
}

// ---------------------------------------------------------------------------
// MOD-06 — lessons and attendance (roadmap §4f; owner decisions D-R30..D-R34,
// CH-0094). Subset of master doc 6.7.4-C: no lesson materials or recordings
// (D-R30), no meeting provider fields (MOD-15). Teacher and room
// double-booking between non-cancelled lessons is refused by two EXCLUDE
// constraints in SQL (D-R34; extension `btree_gist` since CH-0092), which
// Prisma cannot express. Every write on `lessons` goes through MOD-06's
// service (D-R31) — MOD-07 generates lessons from weekly slots through it.
// ---------------------------------------------------------------------------

enum DeliveryMode {
  in_person
  live_online
  recorded
  hybrid

  @@map("delivery_mode")
}

enum LessonStatus {
  scheduled
  in_progress
  completed
  cancelled

  @@map("lesson_status")
}

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@map("attendance_status")
}

/// An actual session of a class at a point in time — generated from a weekly
/// slot (MOD-07-T05) or created by hand. `in_progress` is in the enum but
/// unused in the first version (D-R33: manual complete/cancel/restore).
model Lesson {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId            String       @map("class_id") @db.Uuid
  syllabusItemId     String?      @map("syllabus_item_id") @db.Uuid
  /// The weekly slot this lesson was generated from, if any.
  scheduleId         String?      @map("schedule_id") @db.Uuid
  roomId             String?      @map("room_id") @db.Uuid
  /// One of the class's teachers (service rule); the lead teacher by default
  /// at creation — a snapshot that does not follow later reassignments.
  teacherUserId      String?      @map("teacher_user_id") @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  title              Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  description        Json?
  deliveryMode       DeliveryMode @default(in_person) @map("delivery_mode")
  /// Instants (timestamptz); the academy's or the branch's zone is for display only.
  startsAt           DateTime     @map("starts_at") @db.Timestamptz(6)
  /// > starts_at (CHECK in SQL).
  endsAt             DateTime     @map("ends_at") @db.Timestamptz(6)
  status             LessonStatus @default(scheduled)
  /// A pasted link, https:// only (CHECK in SQL); providers come with MOD-15.
  meetingUrl         String?      @map("meeting_url")
  cancellationReason String?      @map("cancellation_reason")
  attendanceTakenAt  DateTime?    @map("attendance_taken_at") @db.Timestamptz(6)
  createdById        String?      @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  syllabusItem CourseSyllabusItem? @relation(fields: [syllabusItemId], references: [id], onDelete: SetNull)
  schedule     ClassSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  room         Room?               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  teacher      User?               @relation("LessonTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendance   AttendanceRecord[]
  /// MOD-08: assignments linked to this lesson (the link is cleared when the lesson goes).
  assignments  Assignment[]

  @@index([classId, startsAt])
  @@index([teacherUserId, startsAt])
  @@index([roomId, startsAt])
  @@index([status, startsAt])
  @@index([syllabusItemId])
  @@index([scheduleId])
  @@index([createdById])
  @@map("lessons")
}

/// One student's attendance at one lesson, written as an upsert by the
/// teacher (D-R33). The enrollment is checked by the service — no column.
model AttendanceRecord {
  lessonId      String           @map("lesson_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        AttendanceStatus
  /// > 0 and only with status `late` (CHECKs in SQL).
  minutesLate   Int?             @map("minutes_late") @db.SmallInt
  /// The teacher's note — never shown to the student or the guardian (D-R32).
  note          String?
  recordedById  String?          @map("recorded_by") @db.Uuid
  recordedAt    DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student    User   @relation("AttendanceStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  recordedBy User?  @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@id([lessonId, studentUserId])
  @@index([studentUserId])
  @@index([recordedById])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// MOD-08 — assignments and submissions (roadmap §4g; owner decisions
// D-R35..D-R40, CH-0114). Subset of master doc 6.7.4-D: no submission files
// (D-R35 — no `files` table before MOD-15; a submission carries text and/or
// an https link) and no gradebook entries (D-R36 — MOD-09 reads the graded
// submissions). Manual assignment states `draft → open → closed` (D-R37); one
// row per attempt up to `max_attempts` (D-R38); a teacher grades or returns a
// submission (D-R39). `score <= max_score` spans two tables and is a service
// rule; the single-table CHECKs are hand-written SQL in the migration.
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  draft
  open
  closed
  grading
  graded

  @@map("assignment_status")
}

enum SubmissionStatus {
  submitted
  graded
  returned

  @@map("submission_status")
}

/// A piece of work set for a class, optionally tied to one of its lessons.
/// `grading`/`graded` are in the enum but unused in the first version
/// (D-R37 — the grading progress is derived from the submissions).
model Assignment {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  classId            String           @map("class_id") @db.Uuid
  lessonId           String?          @map("lesson_id") @db.Uuid
  /// Localized text `{ ar, en?, tr? }` (D1); `ar` is required (CHECK in SQL).
  title              Json
  /// Localized text `{ ar, en?, tr? }` or NULL (CHECK in SQL).
  instructions       Json?
  /// > 0 (CHECK in SQL); locked once a submission exists (service rule).
  maxScore           Decimal          @map("max_score") @db.Decimal(6, 2)
  /// Weight in the final grade — read by MOD-09 (D-R36); >= 0 (CHECK in SQL).
  weight             Decimal?         @db.Decimal(5, 2)
  status             AssignmentStatus @default(draft)
  /// Set by `publish`; NOT NULL for every status but `draft` (CHECK in SQL).
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(6)
  /// Set by `close`, cleared by `reopen`.
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(6)
  /// Instant (timestamptz); the display zone is the room's branch or the academy's (D-R41).
  dueAt              DateTime?        @map("due_at") @db.Timestamptz(6)
  allowLate          Boolean          @default(false) @map("allow_late")
  /// 0..100 and only with `allow_late` (CHECKs in SQL); applied by MOD-09 (D-R36).
  latePenaltyPercent Decimal?         @map("late_penalty_percent") @db.Decimal(5, 2)
  /// >= 1 (CHECK in SQL); a `returned` submission grants one more attempt (D-R39).
  maxAttempts        Int              @default(1) @map("max_attempts") @db.SmallInt
  createdById        String?          @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson      Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([classId, dueAt])
  @@index([status, dueAt])
  @@index([lessonId])
  @@index([createdById])
  @@map("assignments")
}

/// One attempt of one student on one assignment (D-R38): text and/or an
/// https link (D-R35), later graded (score + feedback) or returned for
/// rework (feedback required) by a teacher (D-R39).
model AssignmentSubmission {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  assignmentId  String           @map("assignment_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  /// >= 1 (CHECK in SQL); unique per (assignment, student).
  attemptNo     Int              @default(1) @map("attempt_no") @db.SmallInt
  submittedAt   DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// Submitted after `due_at` under `allow_late` (service rule).
  isLate        Boolean          @default(false) @map("is_late")
  textAnswer    String?          @map("text_answer")
  /// https:// only; text or link is required (CHECKs in SQL).
  linkUrl       String?          @map("link_url")
  status        SubmissionStatus @default(submitted)
  /// >= 0 and only for `graded` (CHECKs in SQL); <= max_score is a service rule.
  score         Decimal?         @db.Decimal(6, 2)
  /// Required for `returned` (CHECK in SQL).
  feedback      String?
  gradedById    String?          @map("graded_by") @db.Uuid
  /// Set when graded or returned, NULL while `submitted` (CHECK in SQL).
  gradedAt      DateTime?        @map("graded_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("SubmissionStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentUserId, attemptNo], map: "uq_assignment_submissions_attempt")
  @@index([studentUserId])
  @@index([gradedById])
  @@index([assignmentId, status])
  @@map("assignment_submissions")
}
