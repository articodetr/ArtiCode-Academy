# Copy to backend/.env (git-ignored) only if you need to change something: every
# variable is optional and the values below are the defaults applied when absent.
# Schema and validation: src/config/env.schema.ts. Files are read in this order,
# first definition wins: backend/.env.local, backend/.env, ../.env (repository root).

NODE_ENV=development
PORT=3000

# Global route prefix without slashes, e.g. "api" or "api/v1".
API_PREFIX=api

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Serve Swagger UI at /<API_PREFIX>/docs (and the JSON at /<API_PREFIX>/docs-json).
# Default: true outside production, false when NODE_ENV=production (MOD-01-H04);
# set it only to override that, e.g. true on a staging server.
# SWAGGER_ENABLED=true

# Reverse proxies allowed to set X-Forwarded-For / X-Forwarded-Proto (Express
# "trust proxy"), so the audit log, refresh tokens and rate limiting see the real
# client IP and the origin check sees https. Off when empty (the API is reached
# directly). Behind one nginx/Caddy: 1. Or list the proxies: an IP, a CIDR range
# or loopback / linklocal / uniquelocal, separated by commas. "true" is refused:
# it would let any client choose its own IP.
# TRUST_PROXY=1

# --- Database ---------------------------------------------------------------
# The runtime connects as the APPLICATION role (DML only). By default the URL is
# derived from the repository root .env shared with compose.yaml:
#   DB_APP_USER, DB_APP_PASSWORD, DB_HOST (127.0.0.1), POSTGRES_PORT (5432), POSTGRES_DB
# so database credentials are declared once (ADR-019). Optional in development/test
# (the API boots and /api/health/ready reports "not_configured"); in production
# either DATABASE_URL or DB_APP_PASSWORD is REQUIRED.
#
# Override only when the database lives elsewhere (inside Docker Compose the host
# is "postgres"). Use 127.0.0.1 rather than localhost (IPv4 loopback only).
# DATABASE_URL=postgresql://articode_app:change-me@127.0.0.1:5432/articode_academy

# The Prisma CLI (migrate, studio) connects as the MIGRATOR role, derived the same
# way from DB_MIGRATOR_USER / DB_MIGRATOR_PASSWORD. Explicit override:
# MIGRATION_DATABASE_URL=postgresql://articode_migrator:change-me@127.0.0.1:5432/articode_academy

# --- Seed (npx prisma db seed) ---------------------------------------------
# Identity of THIS academy, written to the single `academy` row the first time
# the seed runs (an existing row is never overwritten). Time zone and currency
# are chosen per academy — there is no default. Read by prisma/seed.ts only.
# SEED_ACADEMY_SLUG=my-academy
# SEED_ACADEMY_NAME_AR=اسم الأكاديمية
# SEED_ACADEMY_NAME_EN=Academy name
# SEED_ACADEMY_TIMEZONE=Europe/Istanbul
# SEED_ACADEMY_CURRENCY=TRY
# SEED_ACADEMY_LOCALE=ar

# --- Authentication (MOD-01) -----------------------------------------------
# HS256 secret for access tokens, at least 32 random characters. REQUIRED in
# production. When absent elsewhere the server generates an ephemeral secret at
# boot (access tokens die with the process; refresh cookies keep working).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# JWT_ISSUER=articode-academy
# JWT_AUDIENCE=articode-academy-api
# Access token lifetime in seconds (60–3600).
# JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (1–90); every rotation issues a fresh one.
# AUTH_REFRESH_TTL_DAYS=14
# Absolute session lifetime in days from sign-in (1–365, at least
# AUTH_REFRESH_TTL_DAYS): rotation never extends a session past it (MOD-01-H03).
# AUTH_REFRESH_FAMILY_MAX_DAYS=30
# `Secure` attribute of the refresh cookie: true in production by default.
# AUTH_COOKIE_SECURE=false
# Failed logins per account before a temporary lock, and its length in minutes.
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15

# --- Account lifecycle (MOD-03: invitations, password reset) ----------------
# Lifetime of invitation tokens in hours (1–720) and of password-reset tokens in
# minutes (5–1440). Owner decision D-R02: 48 hours / 30 minutes.
# AUTH_INVITATION_TTL_HOURS=48
# AUTH_PASSWORD_RESET_TTL_MINUTES=30
# Lifetime of the e-mail confirmation link in hours (1–720; LR-01-T02, D-R78: 48).
# AUTH_EMAIL_VERIFICATION_TTL_HOURS=48
# Public "forgot my password" route (POST /api/account/password-reset/request,
# MOD-03-T05). Keep false until an e-mail channel exists (D-R01): the route then
# answers 403 reset_disabled, and reset links are issued by an authorized admin
# through POST /api/users/:id/password-reset and copied by hand. Setting it to
# true is refused at boot while MAIL_TRANSPORT=none (D-R08).
# AUTH_SELF_SERVICE_RESET_ENABLED=false
# Public URL of the web app, used to build the links in the account e-mails and
# in the `link` field of POST /api/users/:id/invitations (`<url>/invite/<token>`)
# and POST /api/users/:id/password-reset (`<url>/reset-password/<token>`);
# without it the links are root-relative (`/invite/<token>`, `/reset-password/<token>`).
# http(s) only, no default, trailing slash ignored.
# APP_PUBLIC_URL=https://academy.example

# --- Mail (MOD-03-T03, owner decision D-R08) ---------------------------------
# How outgoing e-mail is handled. "none" (default): nothing is sent; invitation
# and password-reset tokens are returned once in the API response to the
# authorized admin, who hands the link over. "log" (development ONLY): also
# writes each message, link included, to the server log — refused at boot when
# NODE_ENV=production. "resend" (LR-01, D-R74): sends through the Resend API;
# boot refuses it without RESEND_API_KEY, MAIL_FROM and APP_PUBLIC_URL (links in
# an e-mail must be absolute). The admin still receives the link once in the
# API response (D-R01); a provider failure never fails the request and records
# mail.delivery.failed. The e2e suites always run with "none".
# MAIL_TRANSPORT=none
# Resend API key — a secret: put it in backend/.env.local or backend/.env only,
# never in the repository or the docs.
# RESEND_API_KEY=
# Sender, "address" or "Display Name <address>", on a domain verified at Resend
# (SPF/DKIM). Without a verified domain Resend only accepts its test sender and
# delivers to the account owner's own address.
# MAIL_FROM=Academy <no-reply@mail.academy.example>
# Optional Reply-To of every e-mail (e.g. the academy office).
# MAIL_REPLY_TO=office@academy.example

# --- First academy admin (npm run auth:bootstrap-admin) ---------------------
# Read by scripts/bootstrap-admin.ts only; works while no academy admin exists.
# Prefer typing the password at the prompt instead of storing it here.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_FULL_NAME=Academy Admin
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Demo accounts for LOCAL DEVELOPMENT only (npm run dev:demo-users) -------
# Read by scripts/dev-demo-users.ts only (not in env.schema.ts); refused when
# NODE_ENV=production. Creates — or resets the password of — admin@, teacher@
# and student@<DEMO_USERS_EMAIL_DOMAIN> as active users that share ONE password
# (>= 12 characters). Prefer typing it at the prompt instead of storing it here.
# DEMO_USERS_EMAIL_DOMAIN=articode.com
# DEMO_USERS_PASSWORD=
