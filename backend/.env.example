# Copy to backend/.env (git-ignored) only if you need to change something: every
# variable is optional and the values below are the defaults applied when absent.
# Schema and validation: src/config/env.schema.ts. Files are read in this order,
# first definition wins: backend/.env.local, backend/.env, ../.env (repository root).

NODE_ENV=development
PORT=3000

# Global route prefix without slashes, e.g. "api" or "api/v1".
API_PREFIX=api

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Serve Swagger UI at /<API_PREFIX>/docs (and the JSON at /<API_PREFIX>/docs-json).
# Set to false in production.
SWAGGER_ENABLED=true

# --- Database ---------------------------------------------------------------
# The runtime connects as the APPLICATION role (DML only). By default the URL is
# derived from the repository root .env shared with compose.yaml:
#   DB_APP_USER, DB_APP_PASSWORD, DB_HOST (127.0.0.1), POSTGRES_PORT (5432), POSTGRES_DB
# so database credentials are declared once (ADR-019). Optional in development/test
# (the API boots and /api/health/ready reports "not_configured"); in production
# either DATABASE_URL or DB_APP_PASSWORD is REQUIRED.
#
# Override only when the database lives elsewhere (inside Docker Compose the host
# is "postgres"). Use 127.0.0.1 rather than localhost (IPv4 loopback only).
# DATABASE_URL=postgresql://articode_app:change-me@127.0.0.1:5432/articode_academy

# The Prisma CLI (migrate, studio) connects as the MIGRATOR role, derived the same
# way from DB_MIGRATOR_USER / DB_MIGRATOR_PASSWORD. Explicit override:
# MIGRATION_DATABASE_URL=postgresql://articode_migrator:change-me@127.0.0.1:5432/articode_academy

# --- Seed (npx prisma db seed) ---------------------------------------------
# Identity of THIS academy, written to the single `academy` row the first time
# the seed runs (an existing row is never overwritten). Time zone and currency
# are chosen per academy — there is no default. Read by prisma/seed.ts only.
# SEED_ACADEMY_SLUG=my-academy
# SEED_ACADEMY_NAME_AR=اسم الأكاديمية
# SEED_ACADEMY_NAME_EN=Academy name
# SEED_ACADEMY_TIMEZONE=Europe/Istanbul
# SEED_ACADEMY_CURRENCY=TRY
# SEED_ACADEMY_LOCALE=ar
