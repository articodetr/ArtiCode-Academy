# Build context of the deployment images (deploy/*.Dockerfile, MOD-17, ADR-072).
# Deny by default: only what an image needs is let back in, so a local .env,
# node_modules, dist, .git or the docs can never reach a layer.
*

# --- api image (deploy/api.Dockerfile)
!backend/package.json
!backend/package-lock.json
!backend/nest-cli.json
!backend/tsconfig.json
!backend/tsconfig.build.json
!backend/prisma.config.ts
!backend/prisma.platform.config.ts
!backend/prisma/
!backend/src/
!backend/scripts/

# --- web image (deploy/web.Dockerfile)
# `tsc -b` (npm run build) type-checks all of frontend/src — the *.test.tsx files
# and src/test/ included (tsconfig.app.json: "include": ["src"]) — so they stay in;
# none of them reaches the runtime stage, which takes the Vite dist only.
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/public/
!frontend/src/
!deploy/Caddyfile

# Never, even inside the folders let in above.
**/.env
**/.env.*
**/node_modules/
**/dist/
**/*.tsbuildinfo
backend/src/generated/
backend/scripts/acceptance/
