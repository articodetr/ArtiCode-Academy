# One academy's environment (MOD-17-T03, ADR-072, D-R95) — template only.
#
# Do not copy this file by hand: `node deploy/scripts/new-academy-env.mjs <slug> ...`
# writes deploy/env/<slug>.env with random passwords and JWT secret (mode 600) and
# never prints them. deploy/env/*.env is git-ignored; keep the real file on the server
# only, plus an offline copy of it with the age private key (see the runbook, 14.14).
#
# Used twice by `docker compose -p academy-<slug> -f deploy/compose.academy.yaml
# --env-file deploy/env/<slug>.env ...`: for interpolation, and from there each
# service receives only the variables it needs (compose.academy.yaml).

# --- The site ----------------------------------------------------------------
# The academy's public origin: the Caddy site address, CORS_ORIGIN and APP_PUBLIC_URL.
# https://<domain> on a server (automatic HTTPS); http://localhost[:port] for a local trial.
ACADEMY_ORIGIN=https://academy.example.com
# Host ports of `web`. HTTP_PORT must be the port of ACADEMY_ORIGIN for an http origin
# (Caddy listens on it inside the container); 80 for https (the redirect to https).
HTTP_PORT=80
HTTPS_PORT=443
# 0.0.0.0 on a server; 127.0.0.1 for a local trial.
PUBLISH_ADDRESS=0.0.0.0
# Tag of the locally built images (articode-api, articode-api-tools, articode-web, articode-backup).
ACADEMY_IMAGE_TAG=local

# --- Database (docker/postgres/initdb/10-roles.sh) -----------------------------
POSTGRES_USER=articode
POSTGRES_PASSWORD=change-me
POSTGRES_DB=articode_academy
DB_MIGRATOR_USER=articode_migrator
DB_MIGRATOR_PASSWORD=change-me
DB_APP_USER=articode_app
DB_APP_PASSWORD=change-me

# --- API ----------------------------------------------------------------------
JWT_SECRET=change-me-to-at-least-32-random-characters
# Optional (empty = the API default).
AUTH_COOKIE_SECURE=
AUTH_REFRESH_FAMILY_MAX_DAYS=
# Mail (LR-01): none | resend. resend needs RESEND_API_KEY and MAIL_FROM on a verified domain.
MAIL_TRANSPORT=none
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
AUTH_SELF_SERVICE_RESET_ENABLED=false

# --- First seed of the academy row (prisma/seed.ts; idempotent) -----------------
SEED_ACADEMY_SLUG=example
SEED_ACADEMY_NAME_AR=أكاديمية المثال
SEED_ACADEMY_NAME_EN=Example Academy
SEED_ACADEMY_TIMEZONE=Europe/Istanbul
SEED_ACADEMY_CURRENCY=USD
SEED_ACADEMY_LOCALE=ar

# --- Backups (deploy/backup/, D-R92) --------------------------------------------
BACKUP_RETENTION_DAYS=14
# Cron schedules (five fields or an @keyword) in BACKUP_TZ: nightly dump, monthly drill.
BACKUP_SCHEDULE=30 2 * * *
BACKUP_DRILL_SCHEDULE=0 4 1 * *
BACKUP_TZ=UTC
# Offsite copy: both or neither. An rclone destination such as s3remote:bucket/academy
# (its settings and credentials as RCLONE_CONFIG_<REMOTE>_<OPTION>=... lines in
# deploy/env/<slug>.rclone.env — never inside BACKUP_REMOTE) and an age public key (age1...).
BACKUP_REMOTE=
BACKUP_AGE_RECIPIENT=
