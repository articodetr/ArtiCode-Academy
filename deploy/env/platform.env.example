# The platform's environment (MOD-18-T06, D-R104) — template only.
#
# Do not copy this file by hand: `node deploy/scripts/new-platform-env.mjs ...` writes
# deploy/env/platform.env with random passwords and JWT secret (mode 600) and never
# prints them. deploy/env/*.env is git-ignored; keep the real file on the server only,
# plus an offline copy of it.
#
# Used twice by `docker compose -p articode-platform -f deploy/compose.platform.yaml
# --env-file deploy/env/platform.env ...`: for interpolation, and from there each
# service receives only the variables it needs (compose.platform.yaml). Every variable
# of the platform API is described in backend/src/platform/platform.env.schema.ts.

# --- The site ----------------------------------------------------------------
# The platform's public origin: the Caddy site address of `edge` and PLATFORM_CORS_ORIGIN
# (the OriginGuard allowlist) of the API. https://<domain> on a server (automatic HTTPS);
# http://localhost[:port] for a local trial.
PLATFORM_ORIGIN=https://platform.example.com
# Host ports of `edge`. HTTP_PORT must be the port of PLATFORM_ORIGIN for an http origin
# (Caddy listens on it inside the container); 80 for https (the redirect to https).
# An http origin never serves HTTPS_PORT: a local trial keeps it off 443 (the generator
# uses 8443), so an academy trial can run on the same machine.
HTTP_PORT=80
HTTPS_PORT=443
# 0.0.0.0 on a server; 127.0.0.1 for a local trial.
PUBLISH_ADDRESS=0.0.0.0
# Tag of the locally built images (articode-api, articode-api-tools — the academy's own
# images, D-R97 — and articode-platform-edge).
PLATFORM_IMAGE_TAG=local

# --- Database (docker/postgres/initdb/20-platform.sh) ----------------------------
# The superuser: cluster administration only (created by the postgres image).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PLATFORM_DB_NAME=articode_platform
# Owns the platform database; runs `prisma migrate deploy --config prisma.platform.config.ts`.
PLATFORM_DB_MIGRATOR_USER=platform_migrator
PLATFORM_DB_MIGRATOR_PASSWORD=change-me
# SELECT / INSERT / UPDATE / DELETE only: the API, the probe and the account commands.
PLATFORM_DB_APP_USER=platform_app
PLATFORM_DB_APP_PASSWORD=change-me

# --- API ----------------------------------------------------------------------
# HS256 secret of the platform access tokens (at least 32 characters); never an academy's JWT_SECRET.
PLATFORM_JWT_SECRET=change-me-to-at-least-32-random-characters
# Optional (empty = the platform default: Secure cookie in production, 900 s access
# tokens, 7-day refresh tokens, 14-day sessions, a 15-minute lock after 5 failures).
PLATFORM_COOKIE_SECURE=
PLATFORM_JWT_ACCESS_TTL_SECONDS=
PLATFORM_REFRESH_TTL_DAYS=
PLATFORM_REFRESH_FAMILY_MAX_DAYS=
PLATFORM_LOCKOUT_THRESHOLD=
PLATFORM_LOCKOUT_MINUTES=

# --- Fleet probe (D-R103) -------------------------------------------------------
# Pause between two rounds of the `probe` service (30–86400 s); an item of the fleet
# view is `stale` without a check in 3 × this interval.
PLATFORM_PROBE_INTERVAL_SECONDS=300
# Upper bound of one request to an academy's public endpoint (500–30000 ms).
PLATFORM_PROBE_TIMEOUT_MS=5000
