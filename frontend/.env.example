# Copy to frontend/.env.local (git-ignored). Both variables are optional.

# Base URL for API calls made by the browser. Leave empty to call the same
# origin; in development the Vite proxy forwards /api/* to the backend.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api/* (read by vite.config.ts only;
# never shipped to the browser).
API_PROXY_TARGET=http://localhost:3000
